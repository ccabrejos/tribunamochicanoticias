---
import Layout from '../../layouts/Layout.astro';
import NoticiaCard from '../../components/NoticiaCard.astro';
import { CATEGORIAS, getCategoriaBySlug, getCategoriaSlug, getNoticias } from '../../lib/data';

const { slug } = Astro.params;
const categoriaMeta = slug ? getCategoriaBySlug(slug) : null;

if (!categoriaMeta) {
  Astro.response.status = 404;
} else {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
}

const noticias = categoriaMeta ? await getNoticias(categoriaMeta.nombre) : [];
const siteURL = (Astro.site || 'https://www.tribunamochica.com').toString().replace(/\/$/, '');

const schemas = categoriaMeta
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: `${categoriaMeta.nombre} — Tribuna Mochica`,
        description: categoriaMeta.descripcion,
        url: `${siteURL}/seccion/${categoriaMeta.slug}`,
        inLanguage: 'es-PE',
        isPartOf: { '@id': `${siteURL}/#website` },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Portada', item: `${siteURL}/` },
          { '@type': 'ListItem', position: 2, name: categoriaMeta.nombre, item: `${siteURL}/seccion/${categoriaMeta.slug}` },
        ],
      },
    ]
  : null;
---
<Layout
  title={
    categoriaMeta
      ? `${categoriaMeta.nombre} · Noticias de Lambayeque y Perú | Tribuna Mochica`
      : 'Sección no encontrada | Tribuna Mochica'
  }
  description={categoriaMeta ? categoriaMeta.descripcion : 'La sección solicitada no existe en Tribuna Mochica.'}
  activePath={categoriaMeta ? `/seccion/${categoriaMeta.slug}` : '/noticias'}
  noIndex={!categoriaMeta}
  jsonLd={schemas}
>
  <main id="contenido-principal" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    {!categoriaMeta ? (
      <section class="py-14 px-6 text-center border border-line bg-surface">
        <p class="text-xs uppercase tracking-[0.18em] text-burgundy font-bold mb-2">Error 404</p>
        <h1 class="font-serif text-3xl sm:text-4xl font-black text-ink">Sección no encontrada</h1>
        <p class="mt-3 text-base text-muted max-w-lg mx-auto">
          Explora nuestras secciones editoriales activas o revisa las últimas noticias en portada.
        </p>
        <div class="mt-6 flex justify-center gap-3">
          <a href="/noticias" class="px-5 py-2.5 bg-ink text-white text-sm font-semibold hover:bg-burgundy transition-colors">
            Ver todas las noticias
          </a>
          <a href="/" class="px-5 py-2.5 border border-ink text-ink text-sm font-semibold hover:bg-ink hover:text-white transition-colors">
            Ir a la portada
          </a>
        </div>
      </section>
    ) : (
      <>
        <nav aria-label="Ruta de navegación" class="mb-5 text-xs text-subtle flex items-center gap-2">
          <a href="/" class="hover:text-burgundy transition-colors">Portada</a>
          <span>/</span>
          <span class="text-burgundy font-semibold">{categoriaMeta.nombre}</span>
        </nav>

        <div class="pb-5 border-b-2 border-ink mb-8">
          <p class="text-xs uppercase tracking-[0.18em] text-burgundy font-bold mb-1">Sección Editorial</p>
          <h1 class="font-serif text-3xl sm:text-4xl font-black text-ink">{categoriaMeta.nombre}</h1>
          <p class="mt-2 text-sm sm:text-base text-muted max-w-2xl">{categoriaMeta.descripcion}</p>
        </div>

        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-2 mb-8">
          <a
            href="/noticias"
            class="px-3.5 py-1.5 text-sm rounded-full border transition-colors whitespace-nowrap bg-white text-muted border-line hover:border-ink hover:text-ink"
          >
            Todas
          </a>
          {CATEGORIAS.map((cat) => {
            const catSlug = getCategoriaSlug(cat);
            const active = catSlug === categoriaMeta.slug;
            return (
              <a
                href={`/seccion/${catSlug}`}
                class={`px-3.5 py-1.5 text-sm rounded-full border transition-colors whitespace-nowrap ${
                  active
                    ? 'bg-burgundy text-white border-burgundy font-semibold'
                    : 'bg-white text-muted border-line hover:border-ink hover:text-ink'
                }`}
              >
                {cat}
              </a>
            );
          })}
        </div>

        {noticias.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10">
            {noticias.map((noticia) => (
              <NoticiaCard noticia={noticia} />
            ))}
          </div>
        ) : (
          <div class="py-16 px-6 text-center border border-line bg-surface">
            <p class="font-serif text-xl font-bold text-ink">No hay noticias en {categoriaMeta.nombre} todavía</p>
            <p class="mt-2 text-sm text-muted">Explora todas las publicaciones o revisa nuestras ediciones completas en PDF.</p>
            <div class="mt-6 flex justify-center gap-3">
              <a href="/noticias" class="px-4 py-2 bg-ink text-white text-sm font-semibold hover:bg-burgundy transition-colors">
                Ver todas las noticias
              </a>
              <a href="/ediciones" class="px-4 py-2 border border-ink text-ink text-sm font-semibold hover:bg-ink hover:text-white transition-colors">
                Ver ediciones PDF
              </a>
            </div>
          </div>
        )}
      </>
    )}
  </main>
</Layout>
