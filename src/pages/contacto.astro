---
import BaseLayout from '../layouts/BaseLayout.astro';
import config from '../data/config.json';
---

<BaseLayout 
  title={`Contacto Editorial — ${config.siteName}`}
  description="Ponte en contacto con la dirección y redacción de Tribuna Mochica. Envío de noticias, notas de prensa y denuncias del Valle La Leche."
>
  <div class="container contacto-container">
    <div class="contacto-header">
      <span class="badge-tag">Atención Ciudadana</span>
      <h1 class="page-title">Contacto Editorial</h1>
      <p class="page-subtitle">
        Tribuna Mochica es una tribuna libre. Estamos atentos a tus comunicaciones, notas de prensa, investigaciones comunitarias y avisos de interés público.
      </p>
    </div>

    <div class="contacto-grid">
      <!-- Datos directos -->
      <div class="contacto-info-box">
        <h3 class="info-box-title">Directorio del Semanario</h3>

        <div class="directorio-item">
          <span class="cargo">Director General y Fundador</span>
          <strong class="nombre">{config.director}</strong>
        </div>

        <div class="directorio-item">
          <span class="cargo">Dirección Digital y Edición</span>
          <strong class="nombre">{config.directorDigital}</strong>
        </div>

        <div class="contact-channels">
          <h4 class="channels-title">Canales Oficiales</h4>
          
          <div class="channel-row">
            <div class="channel-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            <div>
              <strong>Ubicación Editorial:</strong>
              <p>{config.ubicacion}</p>
            </div>
          </div>

          <div class="channel-row">
            <div class="channel-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div>
              <strong>Correo Electrónico:</strong>
              <p><a href={`mailto:${config.email}`}>{config.email}</a></p>
            </div>
          </div>

          <div class="channel-row">
            <div class="channel-icon whatsapp-bg">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
            </div>
            <div>
              <strong>WhatsApp de Redacción:</strong>
              <p><a href={config.redes.whatsapp} target="_blank" rel="noopener">Escribir por WhatsApp</a></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Formulario / Botón de Acción -->
      <div class="contacto-cta-box">
        <div class="cta-inner">
          <div class="stamp-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          </div>
          <h3>Envío Rápido por WhatsApp</h3>
          <p>
            Para agilizar la recepción de fotos, audios o comunicados de prensa para la próxima edición impresa o el portal digital, pulsa el botón directo a continuación:
          </p>
          <a href={config.redes.whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
            Contactar a la Redacción
          </a>
          <span class="note-text">Atención editorial permanente para los distritos del Valle La Leche.</span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contacto-container {
    padding: 2.5rem 1rem 3rem 1rem;
  }

  .contacto-header {
    border-bottom: 2px solid var(--color-vino);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .badge-tag {
    background-color: var(--color-vino);
    color: #FFFFFF;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
  }

  .page-title {
    font-size: 2.2rem;
    margin: 0.5rem 0 0.25rem 0;
  }

  .page-subtitle {
    font-size: 1.05rem;
    color: var(--color-tinta-suave);
    max-width: 720px;
  }

  .contacto-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .contacto-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .contacto-info-box {
    background-color: var(--color-papel-card);
    border: 1px solid var(--color-borde);
    border-radius: 8px;
    padding: 1.75rem;
    box-shadow: var(--sombra-card);
  }

  .info-box-title {
    font-size: 1.35rem;
    color: var(--color-vino);
    border-bottom: 1px solid var(--color-borde);
    padding-bottom: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .directorio-item {
    margin-bottom: 1rem;
    background-color: var(--color-papel-oscuro);
    padding: 0.75rem 1rem;
    border-radius: 6px;
    border-left: 3px solid var(--color-vino);
  }

  .directorio-item .cargo {
    display: block;
    font-size: 0.8rem;
    color: var(--color-vino);
    text-transform: uppercase;
  }

  .directorio-item .nombre {
    font-size: 1.05rem;
    color: var(--color-tinta);
  }

  .channels-title {
    font-size: 1.1rem;
    color: var(--color-vino);
    margin: 1.5rem 0 1rem 0;
  }

  .channel-row {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .channel-icon {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background-color: var(--color-papel-oscuro);
    color: var(--color-vino);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid var(--color-borde);
  }

  .whatsapp-bg {
    background-color: #25D366;
    color: #FFF;
    border: none;
  }

  .contacto-cta-box {
    background-color: var(--color-papel-card);
    border: 2px solid var(--color-ocre);
    border-radius: 8px;
    padding: 2rem;
    box-shadow: var(--sombra-card);
    display: flex;
    align-items: center;
  }

  .cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .stamp-icon {
    width: 64px;
    height: 64px;
    background-color: var(--color-ocre-fondo);
    color: var(--color-vino);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-ocre);
  }

  .cta-inner h3 {
    font-size: 1.4rem;
    color: var(--color-vino);
  }

  .cta-inner p {
    font-size: 0.98rem;
    color: var(--color-tinta-suave);
    line-height: 1.6;
  }

  .note-text {
    font-size: 0.8rem;
    color: var(--color-tinta-suave);
    font-style: italic;
  }
</style>
