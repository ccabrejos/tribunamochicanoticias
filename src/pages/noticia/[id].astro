---
import Layout from '../../layouts/Layout.astro';
import NoticiaCard from '../../components/NoticiaCard.astro';
import { getCategoriaSlug, getNoticiaBySlug, getNoticias, toPeruIsoDateTime } from '../../lib/data';
import { renderEditorialHtml } from '../../lib/markdown';

const { id } = Astro.params;
const noticia = id ? await getNoticiaBySlug(id) : null;

if (!noticia) {
  Astro.response.status = 404;
} else {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=300');
}

const todasNoticias = await getNoticias();
const relacionadas = noticia
  ? [
      ...todasNoticias.filter((n) => n.slug !== noticia.slug && n.categoria === noticia.categoria),
      ...todasNoticias.filter((n) => n.slug !== noticia.slug && n.categoria !== noticia.categoria),
    ].slice(0, 3)
  : todasNoticias.slice(0, 3);

const contenidoHtml = noticia ? renderEditorialHtml(noticia.contenido) : '';
const wordCount = noticia ? noticia.contenido.trim().split(/\s+/).filter(Boolean).length : 0;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));

const siteURL = (Astro.site || 'https://www.tribunamochica.com').toString().replace(/\/$/, '');
const shareUrl = noticia ? `${siteURL}/noticia/${noticia.slug}` : `${siteURL}/noticias`;
const categoriaSlug = noticia ? getCategoriaSlug(noticia.categoria) : 'lambayeque';
const whatsappHref = noticia
  ? `https://wa.me/?text=${encodeURIComponent(`${noticia.titular} — Lee la nota en Tribuna Mochica: ${shareUrl}`)}`
  : '';
const facebookHref = noticia
  ? `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`
  : '';

const imageAbsUrl = noticia
  ? (noticia.imagen.startsWith('http') ? noticia.imagen : `${siteURL}${noticia.imagen}`)
  : `${siteURL}/og-default.jpg`;

const showCaption = Boolean(
  noticia?.altImagen &&
  noticia.altImagen.trim().toLowerCase() !== noticia.titular.trim().toLowerCase()
);

const publishedIso = noticia ? toPeruIsoDateTime(noticia.fechaIso) : undefined;
const modifiedIso = noticia ? toPeruIsoDateTime(noticia.fechaIso, noticia.updatedAt) : undefined;

const isOrgAuthor = noticia
  ? /(redacci[oó]n|central|tribuna|prensa)/i.test(noticia.autor)
  : false;

const pageTitle = noticia
  ? noticia.titular.length > 62
    ? `${noticia.titular.slice(0, 59).replace(/\s+\S*$/, '')}… | Tribuna Mochica`
    : `${noticia.titular} | Tribuna Mochica`
  : 'Noticia no encontrada | Tribuna Mochica';

const schemas = noticia
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'NewsArticle',
        headline: noticia.titular,
        description: noticia.bajada,
        image: [imageAbsUrl],
        datePublished: publishedIso,
        dateModified: modifiedIso,
        articleSection: noticia.categoria,
        inLanguage: 'es-PE',
        isAccessibleForFree: true,
        wordCount,
        keywords: Array.from(new Set([noticia.categoria, 'Lambayeque', 'Chiclayo', 'Perú', 'Tribuna Mochica'])),
        contentLocation: {
          '@type': 'Place',
          name: 'Lambayeque, Perú',
        },
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': shareUrl,
        },
        author: {
          '@type': isOrgAuthor ? 'Organization' : 'Person',
          name: noticia.autor,
          url: `${siteURL}/nosotros`,
        },
        publisher: {
          '@id': `${siteURL}/#organization`,
        },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Portada',
            item: `${siteURL}/`,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: noticia.categoria,
            item: `${siteURL}/seccion/${categoriaSlug}`,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: noticia.titular,
            item: shareUrl,
          },
        ],
      },
    ]
  : null;
---
<Layout
  title={pageTitle}
  description={noticia ? noticia.bajada : 'La noticia que buscas no está disponible en Tribuna Mochica.'}
  image={noticia ? noticia.imagen : '/og-default.jpg'}
  activePath={noticia ? `/seccion/${categoriaSlug}` : '/noticias'}
  ogType={noticia ? 'article' : 'website'}
  noIndex={!noticia}
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  section={noticia?.categoria}
  jsonLd={schemas}
>
  <main id="contenido-principal" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    {!noticia ? (
      <section class="py-12 text-center border border-line bg-surface px-6">
        <p class="text-xs uppercase tracking-[0.18em] text-burgundy font-bold mb-2">Error 404</p>
        <h1 class="font-serif text-3xl sm:text-4xl font-black text-ink">Noticia no encontrada</h1>
        <p class="mt-3 text-base text-muted max-w-lg mx-auto">
          El enlace puede haber cambiado o la publicación fue retirada. Explora nuestras últimas notas en portada.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/" class="px-5 py-2.5 bg-ink text-white text-sm font-semibold hover:bg-burgundy transition-colors">
            Ir a la portada
          </a>
          <a href="/noticias" class="px-5 py-2.5 border border-ink text-ink text-sm font-semibold hover:bg-ink hover:text-white transition-colors">
            Ver todas las noticias
          </a>
        </div>
      </section>
    ) : (
      <>
        <nav aria-label="Ruta de navegación" class="mb-6 text-xs text-subtle flex items-center gap-2">
          <a href="/" class="hover:text-burgundy transition-colors">Portada</a>
          <span>/</span>
          <a href={`/seccion/${categoriaSlug}`} class="text-burgundy font-semibold hover:underline">
            {noticia.categoria}
          </a>
        </nav>

        <article>
          <header class="border-b border-line pb-6">
            <span class="inline-block text-xs font-bold uppercase tracking-[0.18em] text-burgundy mb-3">
              {noticia.categoria}
            </span>
            <h1 class="font-serif text-3xl sm:text-5xl font-black text-ink leading-[1.12] tracking-tight">
              {noticia.titular}
            </h1>
            <p class="mt-4 text-lg sm:text-xl text-muted leading-relaxed">
              {noticia.bajada}
            </p>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-4 text-sm text-subtle">
              <div>
                Por <span class="text-ink font-semibold">{noticia.autor}</span>
                <span class="mx-2 text-line">|</span>
                <time datetime={publishedIso}>{noticia.fecha}</time>
                <span class="mx-2 text-line">·</span>
                <span>{readingMinutes} min de lectura</span>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <a
                  href={whatsappHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold border border-line text-ink hover:border-burgundy hover:text-burgundy transition-colors"
                >
                  WhatsApp
                </a>
                <a
                  href={facebookHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold border border-line text-ink hover:border-ink transition-colors"
                >
                  Facebook
                </a>
                <button
                  type="button"
                  id="copy-link-btn"
                  class="px-3.5 py-1.5 text-xs font-semibold border border-line text-ink hover:border-ink transition-colors"
                >
                  Copiar enlace
                </button>
              </div>
            </div>
          </header>

          <figure class="my-8">
            <div class="overflow-hidden border border-line bg-surface">
              <img
                src={noticia.imagen}
                onerror="this.onerror=null; this.src='/noticias/ultima-noticia.jpg';"
                alt={noticia.altImagen || noticia.titular}
                width="1200"
                height="675"
                fetchpriority="high"
                decoding="sync"
                class="w-full max-h-[520px] object-cover"
              />
            </div>
            {showCaption && (
              <figcaption class="mt-2.5 text-xs text-subtle">
                {noticia.altImagen}
              </figcaption>
            )}
          </figure>

          <div
            class="space-y-5 text-base sm:text-lg text-ink/90 leading-[1.85]"
            set:html={contenidoHtml}
          />

          <div class="mt-10 pt-6 border-t border-line flex flex-wrap items-center justify-between gap-4">
            <a href={`/seccion/${categoriaSlug}`} class="text-sm font-semibold text-ink hover:text-burgundy transition-colors">
              ← Más noticias de {noticia.categoria}
            </a>
            <div class="flex flex-wrap gap-2">
              <a
                href={whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 bg-burgundy text-white text-sm font-semibold hover:bg-burgundy-dark transition-colors"
              >
                Compartir por WhatsApp
              </a>
              <a
                href={facebookHref}
                target="_blank"
                rel="noopener noreferrer"
                class="px-4 py-2 border border-ink text-ink text-sm font-semibold hover:bg-ink hover:text-white transition-colors"
              >
                Compartir en Facebook
              </a>
            </div>
          </div>
        </article>
      </>
    )}

    {relacionadas.length > 0 && (
      <section class="mt-16 pt-10 border-t-2 border-ink">
        <h2 class="font-serif text-2xl font-black text-ink mb-6">Más en Tribuna Mochica</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {relacionadas.map((item) => (
            <NoticiaCard noticia={item} />
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>

<script>
  const btn = document.getElementById('copy-link-btn');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      btn.textContent = '¡Enlace copiado!';
      setTimeout(() => (btn.textContent = 'Copiar enlace'), 2200);
    } catch {
      btn.textContent = 'Copiar enlace';
    }
  });
</script>
