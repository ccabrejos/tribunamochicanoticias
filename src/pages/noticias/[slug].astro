---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import NewsCard from '../../components/NewsCard.astro';
import noticias from '../../data/noticias.json';
import config from '../../data/config.json';

export function getStaticPaths() {
  return noticias.map((noticia) => ({
    params: { slug: noticia.slug },
    props: { noticia }
  }));
}

const { noticia } = Astro.props;
const otrasNoticias = noticias.filter(n => n.slug !== noticia.slug).slice(0, 2);
---

<BaseLayout 
  title={`${noticia.titulo} — ${config.siteName}`}
  description={noticia.bajada}
  image={noticia.imagen}
>
  <article class="article-container">
    <div class="container article-inner">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/noticias">Noticias</a>
        <span>/</span>
        <span class="breadcrumb-current">{noticia.categoria}</span>
      </nav>

      <!-- Encabezado de la noticia -->
      <header class="article-header">
        <span class="badge-category">{noticia.categoria}</span>
        <h1 class="article-headline">{noticia.titulo}</h1>
        <p class="article-subheadline">{noticia.bajada}</p>

        <div class="article-byline">
          <div class="author-avatar">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
          </div>
          <div class="byline-details">
            <span class="byline-author">Por <strong>{noticia.autor}</strong></span>
            <div class="byline-meta">
              <span>{noticia.fechaFormateada}</span>
              <span class="meta-dot">•</span>
              <span>{noticia.tiempoLectura} de lectura</span>
              <span class="meta-dot">•</span>
              <span>Valle La Leche</span>
            </div>
          </div>
        </div>
      </header>

      <!-- Botones de compartir arriba -->
      <ShareButtons title={noticia.titulo} />

      <!-- Fotografía principal -->
      <figure class="article-hero-figure">
        <img src={noticia.imagen} alt={noticia.titulo} class="article-hero-image" width="900" height="500" />
        {noticia.pieFoto && (
          <figcaption class="article-figcaption">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
            {noticia.pieFoto}
          </figcaption>
        )}
      </figure>

      <!-- Redacción y cuerpo de la noticia -->
      <div class="article-body">
        {noticia.parrafos.map((parrafo, index) => (
          <p class={index === 0 ? 'lead-paragraph' : ''}>{parrafo}</p>
        ))}
      </div>

      <!-- Cuadro de autor y dirección editorial -->
      <div class="author-bio-box">
        <div class="bio-badge">Dirección Editorial</div>
        <h4 class="bio-name">{noticia.autor}</h4>
        <p class="bio-desc">
          Periodista y Director de <strong>Tribuna Mochica</strong>. Dedicado por más de tres décadas a la crónica regional, investigación comunitaria y defensa del patrimonio agrario y cultural del Valle La Leche.
        </p>
      </div>

      <!-- Botones de compartir abajo -->
      <ShareButtons title={noticia.titulo} />

      <!-- Noticias relacionadas -->
      <section class="related-news-section">
        <h3 class="related-title">Otras Noticias del Valle</h3>
        <div class="related-grid">
          {otrasNoticias.map((item) => (
            <NewsCard
              slug={item.slug}
              titulo={item.titulo}
              bajada={item.bajada}
              autor={item.autor}
              categoria={item.categoria}
              fechaFormateada={item.fechaFormateada}
              imagen={item.imagen}
              tiempoLectura={item.tiempoLectura}
            />
          ))}
        </div>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .article-container {
    padding: 1.5rem 0 3rem 0;
  }

  .article-inner {
    max-width: 820px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--color-tinta-suave);
    margin-bottom: 1.25rem;
  }

  .breadcrumb a {
    color: var(--color-vino);
  }

  .breadcrumb-current {
    color: var(--color-tinta);
    font-weight: 600;
  }

  .article-header {
    margin-bottom: 1.5rem;
  }

  .article-headline {
    font-size: 2rem;
    line-height: 1.2;
    margin: 0.75rem 0 0.85rem 0;
    color: var(--color-vino);
  }

  .article-subheadline {
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--color-tinta-suave);
    font-style: italic;
    margin-bottom: 1.25rem;
  }

  .article-byline {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--color-borde);
    border-bottom: 1px solid var(--color-borde);
  }

  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--color-vino);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .byline-author {
    font-size: 0.95rem;
    color: var(--color-tinta);
  }

  .byline-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--color-tinta-suave);
    margin-top: 0.15rem;
  }

  .meta-dot {
    color: var(--color-ocre);
  }

  .article-hero-figure {
    margin: 1.75rem 0;
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--color-papel-oscuro);
    border: 1px solid var(--color-borde);
  }

  .article-hero-image {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .article-figcaption {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.9rem;
    font-size: 0.85rem;
    color: var(--color-tinta-suave);
    background-color: var(--color-papel-oscuro);
    border-top: 1px solid var(--color-borde);
  }

  .article-body {
    margin: 2rem 0;
  }

  .article-body p {
    font-size: 1.12rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
    color: var(--color-tinta);
  }

  .article-body .lead-paragraph {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.7;
    color: var(--color-vino-oscuro);
    border-left: 4px solid var(--color-ocre);
    padding-left: 1rem;
    margin-bottom: 1.75rem;
  }

  .author-bio-box {
    background-color: var(--color-papel-oscuro);
    border: 2px solid var(--color-borde);
    border-left: 5px solid var(--color-vino);
    padding: 1.5rem;
    border-radius: 8px;
    margin: 2.5rem 0;
  }

  .bio-badge {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-ocre);
    margin-bottom: 0.25rem;
  }

  .bio-name {
    font-size: 1.25rem;
    color: var(--color-vino);
    margin-bottom: 0.4rem;
  }

  .bio-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-tinta-suave);
    margin: 0;
  }

  .related-news-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid var(--color-vino);
  }

  .related-title {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .article-headline {
      font-size: 2.5rem;
    }

    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
