---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import noticias from '../../data/noticias.json';
import config from '../../data/config.json';

const categorias = ['Todas', 'Valle La Leche', 'Agricultura', 'Cultura', 'Opinión'];
---

<BaseLayout 
  title={`Últimas Noticias — ${config.siteName}`}
  description="Todas las noticias, crónicas, reportes agrícolas y columnas de opinión de Tribuna Mochica, la voz del Valle La Leche."
>
  <div class="container noticias-page-header">
    <div class="header-titles">
      <span class="badge-tag">Hemeroteca Digital</span>
      <h1 class="page-title">Últimas Noticias</h1>
      <p class="page-subtitle">Crónicas, reportes y opiniones de nuestros periodistas y colaboradores en el Valle La Leche.</p>
    </div>

    <!-- Buscador y Filtros en Tiempo Real -->
    <div class="search-and-filters">
      <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="newsSearchInput" placeholder="Buscar noticia por título, tema o autor..." />
      </div>

      <div class="category-pills" id="categoryPills">
        {categorias.map((cat, idx) => (
          <button class={`cat-pill ${idx === 0 ? 'active' : ''}`} data-cat={cat}>
            {cat}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="container">
    <div class="news-list-grid" id="newsContainer">
      {noticias.map((item) => (
        <div class="news-item-wrapper" data-category={item.categoria} data-title={item.titulo.toLowerCase()} data-author={item.autor.toLowerCase()} data-excerpt={item.bajada.toLowerCase()}>
          <NewsCard
            slug={item.slug}
            titulo={item.titulo}
            bajada={item.bajada}
            autor={item.autor}
            categoria={item.categoria}
            fechaFormateada={item.fechaFormateada}
            imagen={item.imagen}
            tiempoLectura={item.tiempoLectura}
            destacado={false}
          />
        </div>
      ))}
    </div>

    <div id="noResults" class="no-results-message" style="display: none;">
      <p>No se encontraron noticias que coincidan con tu búsqueda.</p>
      <button class="btn btn-outline btn-sm" id="btnResetSearch">Ver todas las noticias</button>
    </div>
  </div>
</BaseLayout>

<style>
  .noticias-page-header {
    padding: 2.5rem 1rem 1.5rem 1rem;
    border-bottom: 2px solid var(--color-vino);
    margin-bottom: 2rem;
  }

  .badge-tag {
    background-color: var(--color-vino);
    color: #FFFFFF;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
  }

  .page-title {
    font-size: 2.2rem;
    margin: 0.5rem 0 0.25rem 0;
  }

  .page-subtitle {
    font-size: 1.05rem;
    color: var(--color-tinta-suave);
    max-width: 700px;
    margin-bottom: 1.5rem;
  }

  .search-and-filters {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 500px;
  }

  .search-box svg {
    position: absolute;
    left: 14px;
    color: var(--color-vino);
  }

  .search-box input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.6rem;
    font-family: var(--font-cuerpo);
    font-size: 1rem;
    border: 2px solid var(--color-borde);
    border-radius: 6px;
    background-color: #FFF;
    color: var(--color-tinta);
    outline: none;
    transition: border-color 0.2s;
  }

  .search-box input:focus {
    border-color: var(--color-vino);
  }

  .category-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .cat-pill {
    padding: 0.4rem 0.9rem;
    font-family: var(--font-cuerpo);
    font-size: 0.9rem;
    font-weight: 600;
    border: 1px solid var(--color-borde);
    border-radius: 20px;
    background-color: var(--color-papel-card);
    color: var(--color-tinta);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .cat-pill:hover,
  .cat-pill.active {
    background-color: var(--color-vino);
    color: #FFFFFF;
    border-color: var(--color-vino);
  }

  .news-list-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .news-list-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .news-list-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .no-results-message {
    text-align: center;
    padding: 3rem 1rem;
    background-color: var(--color-papel-oscuro);
    border-radius: 8px;
    margin: 2rem 0;
  }

  .no-results-message p {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    color: var(--color-tinta-suave);
  }
</style>

<script>
  const searchInput = document.getElementById('newsSearchInput') as HTMLInputElement;
  const pills = document.querySelectorAll('.cat-pill');
  const newsItems = document.querySelectorAll('.news-item-wrapper');
  const noResults = document.getElementById('noResults');
  const resetBtn = document.getElementById('btnResetSearch');

  let activeCategory = 'Todas';
  let searchTerm = '';

  function filterNews() {
    let visibleCount = 0;

    newsItems.forEach((item) => {
      const itemEl = item as HTMLElement;
      const cat = itemEl.getAttribute('data-category') || '';
      const title = itemEl.getAttribute('data-title') || '';
      const author = itemEl.getAttribute('data-author') || '';
      const excerpt = itemEl.getAttribute('data-excerpt') || '';

      const matchesCat = activeCategory === 'Todas' || cat.toLowerCase() === activeCategory.toLowerCase();
      const matchesSearch = !searchTerm || 
        title.includes(searchTerm) || 
        author.includes(searchTerm) || 
        excerpt.includes(searchTerm);

      if (matchesCat && matchesSearch) {
        itemEl.style.display = 'block';
        visibleCount++;
      } else {
        itemEl.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      searchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterNews();
    });
  }

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeCategory = pill.getAttribute('data-cat') || 'Todas';
      filterNews();
    });
  });

  if (resetBtn && searchInput) {
    resetBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchTerm = '';
      pills.forEach((p, idx) => {
        if (idx === 0) p.classList.add('active');
        else p.classList.remove('active');
      });
      activeCategory = 'Todas';
      filterNews();
    });
  }
</script>
