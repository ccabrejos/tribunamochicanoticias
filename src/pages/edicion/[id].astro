---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ediciones from '../../data/ediciones.json';

export async function getStaticPaths() {
  return ediciones.map((edicion) => ({
    params: { id: String(edicion.id) },
    props: { edicion },
  }));
}

const { edicion } = Astro.props;
---

<Layout title={`${edicion.titulo} | Tribuna Mochica`} description={edicion.resumen}>
  <Header />

  <main class="container viewer-page">
    <div class="viewer-header">
      <a href="/" class="back-link">← Volver al inicio</a>
      <h1>{edicion.titulo}</h1>
      <p class="edition-date">{edicion.fecha}</p>
      <p class="edition-summary">{edicion.resumen}</p>

      <div class="top-actions">
        <a href={edicion.pdf} download class="btn btn-primary">
          📥 Descargar PDF Completo
        </a>
      </div>
    </div>

    <div class="pdf-container">
      <iframe src={`${edicion.pdf}#toolbar=1&navpanes=0`} title={edicion.titulo} class="pdf-frame">
        <p>Tu navegador no soporta visualización directa. <a href={edicion.pdf} download>Haz clic aquí para descargar el PDF</a>.</p>
      </iframe>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .viewer-page {
    padding: 1.25rem 1rem 2.5rem;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .viewer-header {
    text-align: center;
    margin-bottom: 1.25rem;
  }

  .viewer-header h1 {
    font-size: 1.6rem;
  }

  .edition-date {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--ink-muted);
    margin-top: 0.2rem;
  }

  .edition-summary {
    font-size: 0.92rem;
    color: var(--ink-secondary);
    margin: 0.5rem auto 1rem;
    max-width: 600px;
  }

  .top-actions {
    display: flex;
    justify-content: center;
  }

  .pdf-container {
    width: 100%;
    height: 75vh;
    border: 1px solid var(--border-rule);
    background-color: #000;
    margin-top: 1rem;
  }

  .pdf-frame {
    width: 100%;
    height: 100%;
    border: none;
  }

  @media (min-width: 768px) {
    .viewer-header h1 {
      font-size: 2.2rem;
    }
  }
</style>
