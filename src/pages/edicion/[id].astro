---
import Layout from '../../layouts/Layout.astro';
import edicionesData from '../../data/ediciones.json';

export async function getStaticPaths() {
  return edicionesData.map((edicion) => ({
    params: { id: edicion.id },
    props: { edicion },
  }));
}

const { edicion } = Astro.props;
---
<Layout
  title={`Edición N.° ${edicion.numero} - Tribuna Mochica | La Voz del Valle La Leche`}
  description={`${edicion.titular} - Edición N.° ${edicion.numero} de Tribuna Mochica (${edicion.fecha}). ${edicion.bajada}`}
  image={edicion.portadaImg}
>
  <main class="container edition-detail-page">
    <!-- Breadcrumbs -->
    <nav class="breadcrumb-nav" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span>›</span>
      <a href="/#ultimas-noticias">Ediciones</a>
      <span>›</span>
      <strong>Edición N.° {edicion.numero}</strong>
    </nav>

    <article class="featured-card">
      <div class="featured-grid">
        <!-- Portada -->
        <div class="featured-cover-col">
          <div class="cover-wrapper">
            <img
              src={edicion.portadaImg}
              onerror="this.onerror=null; this.src='/ediciones/portada-placeholder.svg';"
              alt={`Portada de Edición N.° ${edicion.numero}`}
              class="featured-cover-img"
            />
            <div class="cover-overlay">
              <button
                type="button"
                class="btn-cover-preview"
                data-open-modal
                data-pdf={edicion.archivoPdf}
                data-title={`Edición N.° ${edicion.numero} (${edicion.fecha})`}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <span>Abrir Visor</span>
              </button>
            </div>
          </div>
          <div class="cover-footer-note">
            <span>📄 Formato PDF ({edicion.paginas || 14} páginas · {edicion.peso || '3.5 MB'})</span>
          </div>
        </div>

        <!-- Info -->
        <div class="featured-info-col">
          <div class="edition-badges">
            <span class="badge badge-burgundy">Edición N.° {edicion.numero}</span>
            <span class="edition-date">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              {edicion.fecha}
            </span>
          </div>

          <h1 class="featured-headline">
            {edicion.titular}
          </h1>

          <p class="featured-description">
            {edicion.bajada}
          </p>

          {edicion.titularesSecundarios && edicion.titularesSecundarios.length > 0 && (
            <div class="inside-news-box">
              <h4 class="inside-news-title">Contenido destacado de esta edición:</h4>
              <ul class="inside-news-list">
                {edicion.titularesSecundarios.map((item) => (
                  <li>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="featured-actions">
            <button
              type="button"
              class="btn btn-primary btn-action-main"
              data-open-modal
              data-pdf={edicion.archivoPdf}
              data-title={`Edición N.° ${edicion.numero} - ${edicion.fecha}`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
              </svg>
              <span>Leer en Pantalla</span>
            </button>

            <a
              href={edicion.archivoPdf}
              download={`Tribuna-Mochica-${edicion.numero}.pdf`}
              class="btn btn-secondary btn-action-download"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Descargar PDF</span>
            </a>

            <button
              type="button"
              class="btn btn-outline btn-action-share"
              data-share-btn
              data-share-title={`Tribuna Mochica - Edición N.° ${edicion.numero}`}
              data-share-text={edicion.titular}
              data-share-url={`/edicion/${edicion.id}`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
              <span>Compartir</span>
            </button>
          </div>
        </div>
      </div>
    </article>
  </main>
</Layout>
