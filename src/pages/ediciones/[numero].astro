---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import ediciones from '../../data/ediciones.json';
import config from '../../data/config.json';

export function getStaticPaths() {
  return ediciones.map((edicion) => ({
    params: { numero: edicion.numero.toString() },
    props: { edicion }
  }));
}

const { edicion } = Astro.props;
---

<BaseLayout 
  title={`Edición N° ${edicion.numero} (PDF) — ${config.siteName}`}
  description={`Lectura en línea y descarga de la Edición N° ${edicion.numero} de Tribuna Mochica (${edicion.fechaLegible}).`}
  image={edicion.portadaUrl}
>
  <div class="container viewer-page-container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb">
      <a href="/">Inicio</a>
      <span>/</span>
      <a href="/ediciones">Ediciones</a>
      <span>/</span>
      <span>Edición N° {edicion.numero}</span>
    </nav>

    <!-- Barra de Control del Visor -->
    <div class="viewer-header">
      <div class="viewer-titles">
        <span class="badge-edition">Edición N° {edicion.numero}</span>
        <h1 class="viewer-headline">{edicion.titulo}</h1>
        <p class="viewer-date">{edicion.fechaLegible}</p>
      </div>

      <div class="viewer-actions">
        <a href={edicion.pdfUrl} download={`Tribuna-Mochica-Edicion-${edicion.numero}.pdf`} class="btn btn-primary btn-sm">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          Descargar PDF
        </a>

        <a href={edicion.pdfUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          Pantalla Completa
        </a>
      </div>
    </div>

    <!-- Visor Embebido Responsive -->
    <div class="pdf-frame-wrapper">
      <iframe 
        src={`${edicion.pdfUrl}#toolbar=1&navpanes=0&scrollbar=1`} 
        class="pdf-iframe" 
        title={`Visor PDF Edición ${edicion.numero}`}
      ></iframe>
      
      <!-- Aviso para dispositivos que no soportan iframe PDF -->
      <div class="mobile-pdf-notice">
        <p>¿No puedes visualizar el documento directamente en tu pantalla móvil?</p>
        <a href={edicion.pdfUrl} target="_blank" class="btn btn-primary btn-sm">
          Abrir o Descargar PDF ({edicion.paginas || 8} páginas)
        </a>
      </div>
    </div>

    <!-- Compartir Edición -->
    <ShareButtons title={`Lee la Edición N° ${edicion.numero} de Tribuna Mochica`} />

    <!-- Resumen y Titulares -->
    <div class="edicion-content-info">
      <h3>Contenido de esta edición</h3>
      <p class="summary-text">{edicion.resumen}</p>
      
      {edicion.titulares && (
        <ul class="edition-headlines-list">
          {edicion.titulares.map(t => (
            <li>• {t}</li>
          ))}
        </ul>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .viewer-page-container {
    padding: 1.5rem 1rem 3rem 1rem;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--color-tinta-suave);
    margin-bottom: 1rem;
  }

  .breadcrumb a {
    color: var(--color-vino);
  }

  .viewer-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--color-vino);
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .viewer-header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .badge-edition {
    background-color: var(--color-vino);
    color: #FFFFFF;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    display: inline-block;
    margin-bottom: 0.3rem;
  }

  .viewer-headline {
    font-size: 1.7rem;
    color: var(--color-vino);
    margin: 0.25rem 0;
  }

  .viewer-date {
    font-size: 0.95rem;
    color: var(--color-tinta-suave);
    margin: 0;
  }

  .viewer-actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .pdf-frame-wrapper {
    background-color: #2D2724;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--sombra-hover);
    margin-bottom: 2rem;
    border: 2px solid var(--color-ocre);
  }

  .pdf-iframe {
    width: 100%;
    height: 80vh;
    min-height: 550px;
    border: none;
    display: block;
    background-color: #525659;
  }

  .mobile-pdf-notice {
    padding: 1.25rem;
    background-color: var(--color-papel-oscuro);
    text-align: center;
    border-top: 1px solid var(--color-borde);
  }

  .mobile-pdf-notice p {
    font-size: 0.92rem;
    margin-bottom: 0.75rem;
    color: var(--color-tinta);
  }

  .edicion-content-info {
    background-color: var(--color-papel-card);
    border: 1px solid var(--color-borde);
    border-left: 4px solid var(--color-ocre);
    padding: 1.5rem;
    border-radius: 8px;
    margin-top: 2rem;
  }

  .edicion-content-info h3 {
    font-size: 1.3rem;
    margin-bottom: 0.75rem;
  }

  .summary-text {
    font-size: 1rem;
    color: var(--color-tinta-suave);
    margin-bottom: 1rem;
  }

  .edition-headlines-list {
    list-style: none;
    padding: 0;
  }

  .edition-headlines-list li {
    font-size: 0.95rem;
    color: var(--color-tinta);
    margin-bottom: 0.4rem;
  }
</style>
