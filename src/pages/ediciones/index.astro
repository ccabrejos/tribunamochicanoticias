---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditionCard from '../../components/EditionCard.astro';
import ediciones from '../../data/ediciones.json';
import config from '../../data/config.json';
---

<BaseLayout 
  title={`Hemeroteca de Ediciones Semanales (PDF) — ${config.siteName}`}
  description="Archivo histórico y coleccionable de todas las ediciones impresas y digitales en formato PDF del periódico Tribuna Mochica."
>
  <div class="container ediciones-page-header">
    <span class="badge-tag">Hemeroteca Semanal</span>
    <h1 class="page-title">Ediciones en PDF</h1>
    <p class="page-subtitle">
      Descarga libremente y lee en línea cada una de las ediciones semanales de Tribuna Mochica. Consulta nuestro archivo histórico completo del Valle La Leche.
    </p>

    <!-- Buscador de ediciones -->
    <div class="ediciones-search-bar">
      <input type="text" id="editionSearchInput" placeholder="Buscar por número de edición (ej. 124) o titular..." />
    </div>
  </div>

  <div class="container">
    <div class="ediciones-archive-grid" id="editionsGrid">
      {ediciones.map((ed) => (
        <div class="edition-item-box" data-numero={ed.numero} data-title={ed.titulo.toLowerCase()} data-summary={ed.resumen.toLowerCase()}>
          <EditionCard
            numero={ed.numero}
            titulo={ed.titulo}
            fechaLegible={ed.fechaLegible}
            pdfUrl={ed.pdfUrl}
            portadaUrl={ed.portadaUrl}
            resumen={ed.resumen}
            titulares={ed.titulares}
            destacado={ed.destacado}
          />
        </div>
      ))}
    </div>

    <div id="noEditions" class="no-editions-msg" style="display: none;">
      <p>No se encontraron ediciones con ese término.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .ediciones-page-header {
    padding: 2.5rem 1rem 1.5rem 1rem;
    border-bottom: 2px solid var(--color-vino);
    margin-bottom: 2rem;
  }

  .badge-tag {
    background-color: var(--color-vino);
    color: #FFFFFF;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
  }

  .page-title {
    font-size: 2.2rem;
    margin: 0.5rem 0 0.25rem 0;
  }

  .page-subtitle {
    font-size: 1.05rem;
    color: var(--color-tinta-suave);
    max-width: 720px;
    margin-bottom: 1.5rem;
  }

  .ediciones-search-bar input {
    width: 100%;
    max-width: 480px;
    padding: 0.75rem 1rem;
    font-family: var(--font-cuerpo);
    font-size: 1rem;
    border: 2px solid var(--color-borde);
    border-radius: 6px;
    outline: none;
  }

  .ediciones-search-bar input:focus {
    border-color: var(--color-vino);
  }

  .ediciones-archive-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .ediciones-archive-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .no-editions-msg {
    text-align: center;
    padding: 3rem 1rem;
    background-color: var(--color-papel-oscuro);
    border-radius: 8px;
    margin: 2rem 0;
    color: var(--color-tinta-suave);
  }
</style>

<script>
  const edInput = document.getElementById('editionSearchInput') as HTMLInputElement;
  const edBoxes = document.querySelectorAll('.edition-item-box');
  const noEd = document.getElementById('noEditions');

  if (edInput) {
    edInput.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
      let matches = 0;

      edBoxes.forEach((box) => {
        const el = box as HTMLElement;
        const num = el.getAttribute('data-numero') || '';
        const title = el.getAttribute('data-title') || '';
        const summary = el.getAttribute('data-summary') || '';

        if (!q || num.includes(q) || title.includes(q) || summary.includes(q)) {
          el.style.display = 'block';
          matches++;
        } else {
          el.style.display = 'none';
        }
      });

      if (noEd) {
        noEd.style.display = matches === 0 ? 'block' : 'none';
      }
    });
  }
</script>
