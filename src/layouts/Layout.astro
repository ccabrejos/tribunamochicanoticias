---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PdfModal from '../components/PdfModal.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  hideChrome?: boolean;
  activePath?: string;
  ogType?: 'website' | 'article';
  noIndex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  jsonLd?: Record<string, any> | Record<string, any>[] | null;
}

const {
  title = 'Tribuna Mochica | Noticias de Lambayeque, Chiclayo y Perú',
  description = 'Periódico digital de Lambayeque, Chiclayo y Perú dirigido por Juan César Cabrejos Becerra. Actualidad regional, nacional, opinión y ediciones PDF.',
  image = '/og-default.jpg',
  hideChrome = false,
  activePath = Astro.url.pathname,
  ogType = 'website',
  noIndex = false,
  publishedTime,
  modifiedTime,
  section,
  jsonLd = null,
} = Astro.props;

const siteURL = (Astro.site || 'https://www.tribunamochica.com').toString().replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, siteURL).href;
const imageURL = image.startsWith('http') ? image : new URL(image, siteURL).href;
const isDefaultOg = image === '/og-default.jpg';

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  '@id': `${siteURL}/#organization`,
  name: 'Tribuna Mochica',
  alternateName: 'Tribuna Mochica Noticias',
  description:
    'Periódico digital y semanario informativo de Lambayeque, Chiclayo y el Valle La Leche, Perú. Dirigido por Juan César Cabrejos Becerra.',
  url: siteURL,
  inLanguage: 'es-PE',
  logo: {
    '@type': 'ImageObject',
    url: `${siteURL}/logo.jpg`,
    width: 320,
    height: 320,
  },
  founder: {
    '@type': 'Person',
    name: 'Juan César Cabrejos Becerra',
    url: `${siteURL}/nosotros`,
  },
  publishingPrinciples: `${siteURL}/nosotros`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Chiclayo',
    addressRegion: 'Lambayeque',
    addressCountry: 'PE',
  },
  areaServed: [
    { '@type': 'City', name: 'Chiclayo' },
    { '@type': 'City', name: 'Lambayeque' },
    { '@type': 'City', name: 'Ferreñafe' },
    { '@type': 'AdministrativeArea', name: 'Región Lambayeque, Perú' },
  ],
  knowsAbout: [
    'Noticias de Lambayeque',
    'Actualidad de Chiclayo',
    'Política y desarrollo regional en Perú',
    'Cultura y deportes en Lambayeque',
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+51-948-100-794',
    email: 'central.mochica.de.prensa@gmail.com',
    contactType: 'editorial',
    areaServed: 'PE',
    availableLanguage: 'es',
  },
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteURL}/#website`,
  name: 'Tribuna Mochica',
  url: siteURL,
  inLanguage: 'es-PE',
  publisher: {
    '@id': `${siteURL}/#organization`,
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteURL}/noticias?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const extraSchemas = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
---
<!DOCTYPE html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="Tribuna Mochica — RSS Noticias" href={`${siteURL}/rss.xml`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="geo.region" content="PE-LAM" />
    <meta name="geo.placename" content="Chiclayo, Lambayeque, Perú" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / WhatsApp / Facebook -->
    <meta property="og:site_name" content="Tribuna Mochica" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={title} />
    {isDefaultOg && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/jpeg" />
      </>
    )}
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}
    {ogType === 'article' && section && (
      <meta property="article:section" content={section} />
    )}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Datos estructurados JSON-LD (SEO regional y SEO para IA) -->
    {!noIndex && (
      <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    )}
    {!noIndex && (
      <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    )}
    {!noIndex && extraSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Tipografías editoriales: Playfair Display & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-ink selection:bg-burgundy selection:text-white">
    {!hideChrome && (
      <a
        href="#contenido-principal"
        class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-ink focus:text-white focus:text-sm focus:font-semibold"
      >
        Saltar al contenido principal
      </a>
    )}
    {!hideChrome && <Header activePath={activePath} />}

    <div class="flex-1">
      <slot />
    </div>

    {!hideChrome && <Footer />}
    {!hideChrome && <PdfModal />}
  </body>
</html>
