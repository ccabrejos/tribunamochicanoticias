---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VisorPdfModal from '../components/VisorPdfModal.astro';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Tribuna Mochica | La Voz del Valle La Leche · Edición Digital",
  description = "Lee y descarga semanalmente el periódico Tribuna Mochica. Dirigido por Juan César Cabrejos Becerra. Noticias de Lambayeque, Valle La Leche, Íllimo, Túcume, Mochumí y la región."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/ediciones/portada-11.svg" />
    <meta property="twitter:card" content="summary_large_image" />

    <!-- Google Fonts: Playfair Display & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,400;1,700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Header />
    
    <main id="contenido-principal">
      <slot />
    </main>

    <Footer />
    
    <!-- Modal universal para lectura interactiva de PDFs -->
    <VisorPdfModal />
  </body>
</html>
