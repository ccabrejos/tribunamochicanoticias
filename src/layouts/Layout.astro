---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PdfModal from '../components/PdfModal.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  hideChrome?: boolean;
  activePath?: string;
  ogType?: 'website' | 'article';
  noIndex?: boolean;
  publishedTime?: string;
  section?: string;
  jsonLd?: Record<string, any> | null;
}

const {
  title = 'Tribuna Mochica | La Voz del Valle La Leche',
  description = 'Portal de noticias y semanario digital Tribuna Mochica. Dirigido por Juan César Cabrejos Becerra. Actualidad de Lambayeque, Valle La Leche, Íllimo, Túcume, Mochumí y la región.',
  image = '/logo.jpg',
  hideChrome = false,
  activePath = Astro.url.pathname,
  ogType = 'website',
  noIndex = false,
  publishedTime,
  section,
  jsonLd = null,
} = Astro.props;

const siteURL = (Astro.site || 'https://tribunamochica.vercel.app').toString().replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, siteURL).href;
const imageURL = image.startsWith('http') ? image : new URL(image, siteURL).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'NewsMediaOrganization',
  name: 'Tribuna Mochica',
  alternateName: 'La Voz del Valle La Leche',
  url: siteURL,
  logo: {
    '@type': 'ImageObject',
    url: `${siteURL}/logo.jpg`,
  },
  founder: {
    '@type': 'Person',
    name: 'Juan César Cabrejos Becerra',
  },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Lambayeque, Perú',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+51-948-100-794',
    email: 'central.mochica.de.prensa@gmail.com',
    contactType: 'editorial',
    areaServed: 'PE',
    availableLanguage: 'es',
  },
};
---
<!DOCTYPE html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / WhatsApp / Facebook -->
    <meta property="og:site_name" content="Tribuna Mochica" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && section && (
      <meta property="article:section" content={section} />
    )}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Datos estructurados JSON-LD (SEO y SEO para IA) -->
    {!noIndex && (
      <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    )}
    {!noIndex && jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Tipografías editoriales: Playfair Display & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;0,800;0,900;1,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-ink selection:bg-burgundy selection:text-white">
    {!hideChrome && <Header activePath={activePath} />}

    <div class="flex-1">
      <slot />
    </div>

    {!hideChrome && <Footer />}
    {!hideChrome && <PdfModal />}
  </body>
</html>
