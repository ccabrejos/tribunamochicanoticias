---
interface Props {
  title: string;
  url?: string;
}

const { title, url = "" } = Astro.props;
---

<div class="share-widget">
  <span class="share-label">Compartir noticia:</span>
  <div class="share-buttons-list">
    <!-- WhatsApp -->
    <a 
      href={`https://api.whatsapp.com/send?text=${encodeURIComponent(title + ' ' + url)}`} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="share-btn share-whatsapp"
      title="Compartir por WhatsApp"
      aria-label="Compartir por WhatsApp"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
      <span>WhatsApp</span>
    </a>

    <!-- Facebook -->
    <a 
      href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="share-btn share-facebook"
      title="Compartir en Facebook"
      aria-label="Compartir en Facebook"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      <span>Facebook</span>
    </a>

    <!-- Copiar Enlace -->
    <button class="share-btn share-copy" id="btnCopyLink" title="Copiar enlace" aria-label="Copiar enlace">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
      <span id="copyText">Copiar Enlace</span>
    </button>
  </div>
</div>

<style>
  .share-widget {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.9rem 0;
    margin: 1.5rem 0;
    border-top: 1px solid var(--color-borde);
    border-bottom: 1px solid var(--color-borde);
  }

  .share-label {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-vino);
  }

  .share-buttons-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
  }

  .share-whatsapp {
    background-color: #25D366;
    color: #FFFFFF !important;
  }

  .share-whatsapp:hover {
    background-color: #1EBE5D;
  }

  .share-facebook {
    background-color: #1877F2;
    color: #FFFFFF !important;
  }

  .share-facebook:hover {
    background-color: #1464CC;
  }

  .share-copy {
    background-color: var(--color-papel-oscuro);
    color: var(--color-tinta);
    border: 1px solid var(--color-borde);
  }

  .share-copy:hover {
    background-color: var(--color-ocre-fondo);
    border-color: var(--color-ocre);
  }
</style>

<script>
  const copyBtn = document.getElementById('btnCopyLink');
  const copyText = document.getElementById('copyText');
  
  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyText.textContent = '¡Enlace copiado!';
        setTimeout(() => {
          copyText.textContent = 'Copiar Enlace';
        }, 2500);
      } catch (err) {
        console.error('Error al copiar:', err);
      }
    });
  }
</script>
