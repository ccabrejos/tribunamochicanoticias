---
import noticias from '../data/noticias.json';

const principal = noticias[0];
const secundarias = noticias.slice(1);
---

<section id="noticias" class="news-block">
  <div class="block-header">
    <h2>Últimas Noticias</h2>
    <div class="line"></div>
  </div>

  {principal && (
    <article class="featured-news">
      <div class="img-container">
        <a href={`/noticia/${principal.id}`}>
          <img src={principal.foto} alt={principal.titulo} loading="eager" />
        </a>
        {principal.pieDeFoto && <span class="caption">{principal.pieDeFoto}</span>}
      </div>

      <div class="content-container">
        <div class="meta-info">
          <span class="category-badge">{principal.categoria}</span>
          <span class="date">{principal.fecha}</span>
        </div>

        <h3 class="main-title">
          <a href={`/noticia/${principal.id}`}>{principal.titulo}</a>
        </h3>

        <p class="byline">Por <strong>{principal.autor}</strong></p>

        <p class="snippet">{principal.resumen}</p>

        <a href={`/noticia/${principal.id}`} class="read-btn">
          Leer redacción completa →
        </a>
      </div>
    </article>
  )}

  {secundarias.length > 0 && (
    <div class="secondary-grid">
      {secundarias.map((item) => (
        <article class="news-card">
          <img src={item.foto} alt={item.titulo} loading="lazy" class="card-img" />
          <div class="card-body">
            <span class="category-badge">{item.categoria}</span>
            <h4 class="card-title">
              <a href={`/noticia/${item.id}`}>{item.titulo}</a>
            </h4>
            <p class="card-meta">Por {item.autor} • {item.fecha}</p>
          </div>
        </article>
      ))}
    </div>
  )}
</section>

<style>
  .news-block {
    padding: 1.25rem 0;
  }

  .block-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .block-header h2 {
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-left: 4px solid var(--color-accent);
    padding-left: 0.5rem;
    white-space: nowrap;
  }

  .line {
    flex: 1;
    height: 1px;
    background-color: var(--border-rule);
  }

  .featured-news {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border-rule);
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .img-container img {
    width: 100%;
    aspect-ratio: 16/9;
    object-fit: cover;
    border: 1px solid var(--border-rule);
  }

  .caption {
    display: block;
    font-size: 0.78rem;
    color: var(--ink-muted);
    font-style: italic;
    margin-top: 0.3rem;
  }

  .meta-info {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--ink-muted);
    margin-bottom: 0.3rem;
  }

  .main-title {
    font-size: 1.35rem;
    margin-bottom: 0.4rem;
  }

  .main-title a:hover {
    color: var(--color-accent);
  }

  .byline {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--ink-secondary);
    margin-bottom: 0.5rem;
  }

  .snippet {
    color: var(--ink-secondary);
    font-size: 0.95rem;
    margin-bottom: 0.8rem;
  }

  .read-btn {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--color-accent);
  }

  .secondary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .news-card {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    border-bottom: 1px solid var(--border-rule);
    padding-bottom: 0.75rem;
  }

  .card-img {
    width: 90px;
    height: 70px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--border-rule);
  }

  .card-title {
    font-size: 0.98rem;
    line-height: 1.3;
    margin-top: 0.2rem;
  }

  .card-meta {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--ink-muted);
    margin-top: 0.3rem;
  }

  @media (min-width: 768px) {
    .featured-news {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 1.5rem;
      align-items: center;
    }
    .main-title {
      font-size: 1.75rem;
    }
    .secondary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
