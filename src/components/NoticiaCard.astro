---
import type { Noticia } from '../lib/data';

interface Props {
  noticia: Noticia;
}

const { noticia } = Astro.props;
---
<article class="group flex flex-col border-b border-line pb-6 sm:border-b-0 sm:pb-0">
  <a href={`/noticia/${noticia.slug}`} class="block overflow-hidden bg-surface aspect-[16/10] mb-3.5 border border-line/70">
    <img
      src={noticia.imagen}
      onerror="this.onerror=null; this.src='/noticias/ultima-noticia.jpg';"
      alt={noticia.altImagen || noticia.titular}
      width="800"
      height="500"
      class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="flex items-center gap-2 text-xs uppercase tracking-[0.12em] mb-1.5">
    <span class="font-bold text-burgundy">{noticia.categoria}</span>
    <span class="text-line">·</span>
    <time datetime={noticia.fechaIso} class="text-subtle">{noticia.fecha}</time>
  </div>
  <h3 class="font-serif text-xl font-bold text-ink leading-snug group-hover:text-burgundy transition-colors">
    <a href={`/noticia/${noticia.slug}`}>{noticia.titular}</a>
  </h3>
  <p class="mt-2 text-sm text-muted leading-relaxed line-clamp-3">
    {noticia.bajada}
  </p>
  <p class="mt-3 text-xs text-subtle">
    Por <span class="text-ink font-medium">{noticia.autor}</span>
  </p>
</article>
