---
import type { Edicion } from '../lib/data';

interface Props {
  edicion: Edicion;
  isLatest?: boolean;
}

const { edicion, isLatest = false } = Astro.props;
---
<article
  class="group flex flex-col bg-white border border-line hover:border-ink/40 transition-colors"
  data-edicion-card
  data-search={`${edicion.numero} ${edicion.fecha} ${edicion.titular} ${edicion.bajada}`.toLowerCase()}
>
  <a href={`/edicion/${edicion.numero}`} class="relative block aspect-[3/4] bg-surface overflow-hidden border-b border-line">
    <img
      src={edicion.portadaImg}
      onerror="this.onerror=null; this.src='/ediciones/portada-placeholder.svg';"
      alt={`Portada Edición N.° ${edicion.numero}`}
      width="600"
      height="800"
      class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
      loading="lazy"
      decoding="async"
    />
    <span class="absolute top-3 left-3 px-2.5 py-1 text-xs font-bold uppercase tracking-wider bg-ink text-white">
      Edición N.° {edicion.numero}
    </span>
    {isLatest && (
      <span class="absolute top-3 right-3 px-2 py-1 text-xs font-bold uppercase tracking-wider bg-burgundy text-white">
        Reciente
      </span>
    )}
  </a>

  <div class="p-4 flex-1 flex flex-col">
    <p class="text-xs text-subtle mb-1">{edicion.fecha}</p>
    <h3 class="font-serif text-lg font-bold text-ink leading-snug group-hover:text-burgundy transition-colors">
      <a href={`/edicion/${edicion.numero}`}>{edicion.titular}</a>
    </h3>
    {edicion.bajada && (
      <p class="mt-2 text-xs text-muted leading-relaxed line-clamp-2 flex-1">
        {edicion.bajada}
      </p>
    )}
    <div class="mt-4 pt-3 border-t border-line flex items-center gap-2">
      <button
        type="button"
        data-open-pdf
        data-pdf={edicion.archivoPdf}
        data-title={`Edición N.° ${edicion.numero} (${edicion.fecha})`}
        class="flex-1 px-3 py-2 text-xs font-semibold bg-ink text-white hover:bg-burgundy transition-colors text-center"
      >
        Leer PDF
      </button>
      <a
        href={edicion.archivoPdf}
        download
        class="px-3 py-2 text-xs font-semibold border border-line text-ink hover:border-ink transition-colors text-center"
        title="Descargar archivo PDF"
      >
        Descargar
      </a>
    </div>
  </div>
</article>
