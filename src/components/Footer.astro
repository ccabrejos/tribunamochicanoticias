---
// Footer.astro - Pie de página institucional y de alta legibilidad
---

<footer class="site-footer">
  <!-- Línea decorativa superior con colores Borgoña y Dorado Mochica -->
  <div class="divider-mochica"></div>

  <div class="container footer-main">
    <div class="footer-grid">
      
      <!-- Columna 1: Identidad y Dirección -->
      <div class="footer-brand-col">
        <div class="footer-logo-wrap">
          <img src="/logo.jpg" alt="Tribuna Mochica Logo" class="footer-logo" width="65" height="65" />
          <div>
            <h3 class="footer-title">TRIBUNA MOCHICA</h3>
            <p class="footer-slogan">LA VOZ DEL VALLE LA LECHE</p>
          </div>
        </div>

        <div class="footer-director-info">
          <span class="f-dir-label">Fundador y Director:</span>
          <strong class="f-dir-name">Juan César Cabrejos Becerra</strong>
          <p class="f-dir-desc">Comprometidos con la verdad, el desarrollo regional y la identidad cultural de nuestros pueblos.</p>
        </div>
      </div>

      <!-- Columna 2: Enlaces Rápidos -->
      <div class="footer-links-col">
        <h4 class="footer-heading">NAVEGACIÓN</h4>
        <ul class="footer-links-list">
          <li><a href="#portada">Portada de la semana</a></li>
          <li><a href="#ultimas-noticias">Ediciones pasadas</a></li>
          <li><a href="#enviar-noticia">Envíanos tu noticia</a></li>
        </ul>
      </div>

      <!-- Columna 3: Contacto Editorial -->
      <div class="footer-contact-col">
        <h4 class="footer-heading">CONTACTO EDITORIAL</h4>
        <p class="contact-desc">Para avisos y publicidad:</p>
        
        <div class="contact-links">
          <a href="https://wa.me/51948100794" target="_blank" rel="noopener noreferrer" class="contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C29B38" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="contact-icon">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>WhatsApp: +51 948 100 794</span>
          </a>

          <a href="mailto:central.mochica.de.prensa@gmail.com" class="contact-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C29B38" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="contact-icon">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>central.mochica.de.prensa@gmail.com</span>
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Barra Inferior de Derechos -->
  <div class="footer-bottom">
    <div class="container bottom-inner">
      <p class="copyright">
        © 2026 <strong>Tribuna Mochica</strong> · Todos los derechos reservados.
      </p>
      <p class="credits">
        Periódico Semanal · Lambayeque, Perú
      </p>
    </div>
  </div>
</footer>

<style>
  /* Contenedor principal con fondo oscuro sólido y contraste garantizado */
  .site-footer {
    background-color: #141210 !important;
    color: #E2DBD0 !important;
    margin-top: auto;
    width: 100%;
  }

  /* Línea decorativa superior */
  .divider-mochica {
    height: 3px;
    background: linear-gradient(90deg, #7A0C16 0%, #C29B38 50%, #7A0C16 100%);
    width: 100%;
  }

  .footer-main {
    padding: 3rem 1.25rem 2.25rem 1.25rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1.5fr;
      gap: 2.5rem;
    }
  }

  /* Columna 1: Marca e Identidad */
  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-logo-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-logo {
    width: 65px;
    height: 65px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid rgba(194, 155, 56, 0.4);
    background-color: #FFFFFF;
  }

  .footer-title {
    font-size: 1.35rem;
    color: #FFFFFF !important;
    letter-spacing: 0.05em;
    margin: 0;
    font-family: "Playfair Display", Georgia, serif;
    font-weight: 700;
  }

  .footer-slogan {
    font-size: 0.75rem;
    color: #C29B38 !important;
    letter-spacing: 0.15em;
    font-weight: 600;
    margin-top: 3px;
    text-transform: uppercase;
  }

  /* Información del Director */
  .footer-director-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 0.25rem;
  }

  .f-dir-label {
    font-size: 0.75rem;
    color: #D4A017 !important;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .f-dir-name {
    font-size: 1rem;
    color: #FFFFFF !important;
    font-weight: 700;
  }

  .f-dir-desc {
    font-size: 0.85rem;
    color: #D8D1C7 !important;
    line-height: 1.5;
    margin-top: 0.2rem;
  }

  /* Columna 2: Navegación */
  .footer-heading {
    font-size: 0.9rem;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 700;
    color: #C29B38 !important;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.85rem;
  }

  .footer-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 0;
    margin: 0;
  }

  .footer-links-list a {
    color: #E2DBD0 !important;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .footer-links-list a:hover {
    color: #D4A017 !important;
    transform: translateX(4px);
  }

  /* Columna 3: Contacto Editorial */
  .contact-desc {
    font-size: 0.85rem;
    color: #D8D1C7 !important;
    margin-bottom: 0.85rem;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.88rem;
    color: #FFFFFF !important;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-icon {
    flex-shrink: 0;
  }

  .contact-item:hover {
    color: #D4A017 !important;
  }

  /* Barra Inferior de Derechos */
  .footer-bottom {
    background-color: #0D0B0A !important;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1.25rem 0;
    font-size: 0.82rem;
    color: #B8B0A5 !important;
  }

  .bottom-inner {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: center;
    text-align: center;
  }

  @media (min-width: 640px) {
    .bottom-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .copyright strong {
    color: #FFFFFF !important;
  }

  .credits {
    color: #B8B0A5 !important;
  }
</style>
