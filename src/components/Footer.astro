---
const year = new Date().getFullYear();
---
<footer class="bg-white border-t-2 border-ink mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
      <!-- Identidad -->
      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <img
            src="/logo.jpg"
            onerror="this.onerror=null; this.src='/logo-mochica.svg';"
            alt="Tribuna Mochica"
            class="w-11 h-11 rounded-full object-cover border border-line"
            width="44"
            height="44"
          />
          <div>
            <h2 class="font-serif text-xl font-black tracking-tight text-ink">TRIBUNA MOCHICA</h2>
            <p class="text-[11px] uppercase tracking-[0.18em] text-burgundy font-semibold">
              La Voz del Valle La Leche
            </p>
          </div>
        </div>
        <p class="mt-4 text-sm text-muted leading-relaxed max-w-md">
          Comprometidos con la verdad, el desarrollo regional y la identidad cultural de Lambayeque, Íllimo, Túcume, Mochumí y todo el Valle La Leche.
        </p>
        <p class="mt-3 text-sm text-ink">
          <span class="text-subtle">Fundador y Director:</span> <strong>Juan César Cabrejos Becerra</strong>
        </p>
      </div>

      <!-- Secciones -->
      <div class="md:col-span-3">
        <h3 class="font-sans text-xs font-bold uppercase tracking-[0.16em] text-ink mb-4">
          Secciones
        </h3>
        <ul class="space-y-2.5 text-sm text-muted">
          <li><a href="/" class="hover:text-burgundy transition-colors">Portada</a></li>
          <li><a href="/noticias" class="hover:text-burgundy transition-colors">Todas las noticias</a></li>
          <li><a href="/ediciones" class="hover:text-burgundy transition-colors">Hemeroteca (Ediciones PDF)</a></li>
          <li><a href="/enviar-noticia" class="hover:text-burgundy transition-colors">Envíanos tu noticia</a></li>
          <li><a href="/redaccion" class="hover:text-burgundy transition-colors">Acceso Redacción</a></li>
        </ul>
      </div>

      <!-- Contacto editorial -->
      <div class="md:col-span-4">
        <h3 class="font-sans text-xs font-bold uppercase tracking-[0.16em] text-ink mb-4">
          Contacto Editorial
        </h3>
        <p class="text-sm text-muted mb-4">
          Para notas de prensa, avisos, suscripciones y publicidad:
        </p>
        <div class="space-y-2.5 text-sm">
          <a
            href="https://wa.me/51948100794"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 text-ink hover:text-burgundy font-medium transition-colors"
          >
            <span class="w-8 h-8 rounded-full border border-line flex items-center justify-center text-burgundy">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </span>
            <span>WhatsApp: +51 948 100 794</span>
          </a>
          <a
            href="mailto:central.mochica.de.prensa@gmail.com"
            class="flex items-center gap-2.5 text-ink hover:text-burgundy font-medium transition-colors break-all"
          >
            <span class="w-8 h-8 rounded-full border border-line flex items-center justify-center text-burgundy shrink-0">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </span>
            <span>central.mochica.de.prensa@gmail.com</span>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-line flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-subtle">
      <p>© {year} <strong class="text-ink">Tribuna Mochica</strong>. Todos los derechos reservados.</p>
      <p>Periódico Digital · Lambayeque, Perú</p>
    </div>
  </div>
</footer>
