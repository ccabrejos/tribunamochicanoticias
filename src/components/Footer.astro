---
import config from '../data/config.json';
---

<footer class="site-footer">
  <div class="footer-top-border"></div>

  <div class="container footer-content">
    <div class="footer-grid">
      <!-- Columna 1: Periódico & Dirección -->
      <div class="footer-col brand-col">
        <div class="footer-brand">
          <img src="/images/logo.jpg" alt="Logo Tribuna Mochica" class="footer-logo" width="65" height="65" />
          <div>
            <h3 class="footer-title">{config.siteName}</h3>
            <p class="footer-slogan">{config.siteTagline}</p>
          </div>
        </div>
        <p class="footer-desc">
          Periódico independiente al servicio de la verdad y de los pueblos del Valle La Leche: Íllimo, Túcume, Mochumí, Pacora, Jayanca, Pítipo y Ferreñafe.
        </p>

        <!-- Bloque de Dirección Editorial -->
        <div class="directors-box">
          <div class="director-item">
            <span class="label">Director General:</span>
            <strong>{config.director}</strong>
          </div>
          <div class="director-item">
            <span class="label">Dirección Digital:</span>
            <strong>{config.directorDigital}</strong>
          </div>
        </div>
      </div>

      <!-- Columna 2: Navegación -->
      <div class="footer-col nav-col">
        <h4 class="footer-heading">Navegación</h4>
        <ul class="footer-links">
          <li><a href="/">• Portada Principal</a></li>
          <li><a href="/noticias">• Últimas Noticias</a></li>
          <li><a href="/#edicion-actual">• Edición Semanal Actual</a></li>
          <li><a href="/ediciones">• Archivo de Ediciones (PDF)</a></li>
          <li><a href="/contacto">• Contacto Editorial</a></li>
        </ul>
      </div>

      <!-- Columna 3: Contacto Editorial & Redes -->
      <div class="footer-col contact-col">
        <h4 class="footer-heading">Contacto Editorial</h4>
        <p class="contact-text">
          ¿Tienes una noticia, denuncia vecinal o comunicado oficial? Contáctanos directamente:
        </p>
        <ul class="contact-info">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span>{config.ubicacion}</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <a href={`mailto:${config.email}`}>{config.email}</a>
          </li>
        </ul>

        <div class="footer-cta">
          <a href="https://wa.me/51974000000?text=Hola%20Tribuna%20Mochica,%20deseo%20enviar%20una%20noticia" target="_blank" rel="noopener" class="btn btn-whatsapp btn-sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
            WhatsApp Editorial
          </a>
        </div>
      </div>
    </div>

    <!-- Barra inferior de copyright -->
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} <strong>TRIBUNA MOCHICA</strong> — Todos los derechos reservados.</p>
      <p class="footer-subtext">Edición Semanal Digital e Impresa • Valle La Leche, Lambayeque - Perú</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background-color: #241D1A;
    color: #E6DFD5;
    position: relative;
  }

  .footer-top-border {
    height: 6px;
    background: linear-gradient(90deg, var(--color-vino) 0%, var(--color-ocre) 50%, var(--color-vino) 100%);
  }

  .footer-content {
    padding: 3rem 1rem 1.5rem 1rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.4fr 0.8fr 1fr;
      gap: 2rem;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1rem;
  }

  .footer-logo {
    border-radius: 50%;
    border: 2px solid var(--color-ocre);
    background-color: #FFF;
  }

  .footer-title {
    font-family: var(--font-masthead);
    font-size: 1.45rem;
    color: #FFFFFF;
    letter-spacing: 1px;
    margin: 0;
  }

  .footer-slogan {
    font-family: var(--font-titulares);
    font-size: 0.9rem;
    color: var(--color-ocre-brillante);
    font-style: italic;
    margin: 0;
  }

  .footer-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #D3C9BD;
    margin-bottom: 1.25rem;
  }

  .directors-box {
    background-color: rgba(255, 255, 255, 0.05);
    border-left: 3px solid var(--color-ocre);
    padding: 0.75rem 1rem;
    border-radius: 0 6px 6px 0;
  }

  .director-item {
    font-size: 0.9rem;
    margin-bottom: 0.35rem;
  }

  .director-item:last-child {
    margin-bottom: 0;
  }

  .director-item .label {
    color: var(--color-ocre);
    font-size: 0.82rem;
    display: block;
  }

  .director-item strong {
    color: #FFFFFF;
  }

  .footer-heading {
    font-family: var(--font-titulares);
    font-size: 1.2rem;
    color: var(--color-ocre-brillante);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 1rem;
    position: relative;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgba(198, 146, 60, 0.3);
  }

  .footer-links {
    list-style: none;
    padding: 0;
  }

  .footer-links li {
    margin-bottom: 0.65rem;
  }

  .footer-links li a {
    color: #D3C9BD !important;
    font-size: 0.98rem;
    transition: color 0.2s;
  }

  .footer-links li a:hover {
    color: var(--color-ocre-brillante) !important;
    padding-left: 4px;
  }

  .contact-text {
    font-size: 0.92rem;
    color: #D3C9BD;
    margin-bottom: 1rem;
  }

  .contact-info {
    list-style: none;
    padding: 0;
    margin-bottom: 1.25rem;
  }

  .contact-info li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
    font-size: 0.92rem;
    color: #EAE3D9;
  }

  .contact-info svg {
    color: var(--color-ocre);
    flex-shrink: 0;
  }

  .contact-info a {
    color: #EAE3D9 !important;
  }

  .contact-info a:hover {
    color: var(--color-ocre-brillante) !important;
  }

  .footer-cta {
    margin-top: 1rem;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 1.5rem;
    text-align: center;
    font-size: 0.88rem;
    color: #A89F93;
  }

  .footer-bottom strong {
    color: #FFFFFF;
  }

  .footer-subtext {
    font-size: 0.82rem;
    margin-top: 0.25rem;
  }
</style>
