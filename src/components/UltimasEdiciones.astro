---
import ediciones from '../data/ediciones.json';

const edicionActual = ediciones[0];
const anteriores = ediciones.slice(1);
---

<section id="ediciones" class="ediciones-block">
  <div class="block-header">
    <h2>Edición Impresa Semanal</h2>
    <div class="line"></div>
  </div>

  {edicionActual && (
    <div class="current-edition">
      <div class="cover-col">
        <a href={`/edicion/${edicionActual.id}`}>
          <img src={edicionActual.portada} alt={edicionActual.titulo} class="edition-cover" />
        </a>
      </div>

      <div class="info-col">
        <span class="badge-edition">Edición Digitalizada Nº {edicionActual.numero}</span>
        <h3 class="edition-title">{edicionActual.titulo}</h3>
        <p class="edition-date">{edicionActual.fecha}</p>
        <p class="edition-desc">{edicionActual.resumen}</p>

        <div class="action-buttons">
          <a href={`/edicion/${edicionActual.id}`} class="btn btn-primary">
            📖 Leer edición completa
          </a>
          <a href={edicionActual.pdf} download class="btn btn-outline">
            📥 Descargar PDF
          </a>
        </div>
      </div>
    </div>
  )}

  {anteriores.length > 0 && (
    <div class="archive-box">
      <h4 class="archive-title">Hemeroteca — Ediciones Anteriores</h4>
      <div class="archive-list">
        {anteriores.map((ed) => (
          <div class="archive-item">
            <img src={ed.portada} alt={ed.titulo} class="archive-thumb" />
            <div class="archive-meta">
              <strong>{ed.titulo}</strong>
              <span class="archive-date">{ed.fecha}</span>
              <div class="archive-links">
                <a href={`/edicion/${ed.id}`}>Leer en línea</a>
                <span>•</span>
                <a href={ed.pdf} download>PDF</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}
</section>

<style>
  .ediciones-block {
    padding: 1.5rem 0;
    margin-top: 1rem;
    border-top: 2px solid var(--border-dark);
  }

  .block-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .block-header h2 {
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-left: 4px solid var(--ink-primary);
    padding-left: 0.5rem;
  }

  .line {
    flex: 1;
    height: 1px;
    background-color: var(--border-rule);
  }

  .current-edition {
    background-color: var(--bg-card);
    border: 1px solid var(--border-rule);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .edition-cover {
    width: 100%;
    max-height: 380px;
    object-fit: contain;
    background-color: #000000;
    border: 1px solid var(--border-rule);
  }

  .badge-edition {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .edition-title {
    font-size: 1.35rem;
    margin-top: 0.2rem;
  }

  .edition-date {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--ink-muted);
    margin-bottom: 0.4rem;
  }

  .edition-desc {
    font-size: 0.92rem;
    color: var(--ink-secondary);
    margin-bottom: 1rem;
  }

  .action-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .archive-box {
    margin-top: 1.5rem;
    background-color: var(--bg-contrast);
    padding: 1rem;
    border-radius: 2px;
  }

  .archive-title {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.8rem;
  }

  .archive-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  .archive-item {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    background: #ffffff;
    padding: 0.5rem;
    border: 1px solid var(--border-rule);
  }

  .archive-thumb {
    width: 50px;
    height: 65px;
    object-fit: cover;
  }

  .archive-meta {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    display: flex;
    flex-direction: column;
  }

  .archive-date {
    font-size: 0.72rem;
    color: var(--ink-muted);
  }

  .archive-links {
    margin-top: 0.2rem;
    display: flex;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  @media (min-width: 768px) {
    .current-edition {
      flex-direction: row;
      align-items: center;
      padding: 1.5rem;
      gap: 1.75rem;
    }
    .cover-col {
      max-width: 250px;
      flex-shrink: 0;
    }
    .action-buttons {
      flex-direction: row;
    }
    .archive-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
