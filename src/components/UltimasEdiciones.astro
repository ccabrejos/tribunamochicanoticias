---
import ediciones from '../data/ediciones.json';
---

<section id="ediciones" class="ediciones-section">
  <div class="section-title-wrap">
    <h2 class="section-title">Edición Impresa Digitalizada</h2>
    <span class="line"></span>
  </div>

  <div class="ediciones-list">
    {ediciones.map((edicion) => (
      <div class="edicion-card">
        <div class="edicion-thumb">
          <img src={edicion.portada} alt={edicion.titulo} loading="lazy" />
        </div>
        
        <div class="edicion-details">
          <div class="edicion-tag">Edición Semanal Nº {edicion.numero}</div>
          <h3 class="edicion-title">{edicion.titulo}</h3>
          <p class="edicion-date">{edicion.fecha}</p>
          <p class="edicion-desc">{edicion.resumen}</p>

          <div class="edicion-actions">
            <a href={`/edicion/${edicion.id}`} class="btn btn-primary">
              📖 Leer en línea
            </a>
            <a href={edicion.pdf} download class="btn btn-outline">
              📥 Descargar PDF
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .ediciones-section {
    padding: 1.5rem 0 2.5rem;
    background-color: var(--bg-muted);
    margin: 1.5rem -1rem;
    padding-left: 1rem;
    padding-right: 1rem;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-title-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .section-title {
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-left: 4px solid var(--ink-primary);
    padding-left: 0.5rem;
  }

  .line {
    flex: 1;
    height: 1px;
    background: var(--border-subtle);
  }

  .edicion-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .edicion-thumb img {
    width: 100%;
    max-height: 380px;
    object-fit: contain;
    background: #000;
    border: 1px solid var(--border-subtle);
  }

  .edicion-tag {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-accent);
  }

  .edicion-title {
    font-size: 1.35rem;
    margin-top: 0.25rem;
  }

  .edicion-date {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--ink-muted);
    margin-bottom: 0.5rem;
  }

  .edicion-desc {
    font-size: 0.95rem;
    color: var(--ink-secondary);
    margin-bottom: 1rem;
  }

  .edicion-actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  @media (min-width: 768px) {
    .ediciones-section {
      margin: 2rem 0;
      border-radius: 2px;
    }
    .edicion-card {
      flex-direction: row;
      align-items: center;
      padding: 1.5rem;
      gap: 2rem;
    }
    .edicion-thumb {
      max-width: 260px;
      flex-shrink: 0;
    }
    .edicion-actions {
      flex-direction: row;
    }
  }
</style>
