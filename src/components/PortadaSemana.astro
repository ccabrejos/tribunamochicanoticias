---
export interface Props {
  edicion: {
    id: string;
    numero: number;
    fecha: string;
    titular: string;
    bajada: string;
    titularesSecundarios?: string[];
    paginas?: number;
    peso?: string;
    archivoPdf: string;
    portadaImg: string;
  };
}

const { edicion } = Astro.props;
---
<section id="portada" class="portada-section">
  <div class="container">
    <div class="section-header">
      <div class="section-title-wrap">
        <span class="badge badge-burgundy">EDICIÓN ACTUAL</span>
        <h2 class="section-title">Portada de la Semana</h2>
      </div>
      <div class="section-meta">
        <span class="pulse-dot"></span>
        <span class="section-meta-text">Publicación más reciente</span>
      </div>
    </div>

    <!-- Tarjeta Principal de la Edición Destacada -->
    <article class="featured-card">
      <div class="featured-grid">
        <!-- Columna Izquierda: Vista de Portada Interactiva -->
        <div class="featured-cover-col">
          <div class="cover-wrapper">
            <span class="ribbon-edition">ÚLTIMA EDICIÓN</span>
            <img
              src={edicion.portadaImg}
              onerror="this.onerror=null; this.src='/ediciones/portada-placeholder.svg';"
              alt={`Portada de Edición N.° ${edicion.numero} - ${edicion.fecha}`}
              class="featured-cover-img"
              loading="eager"
            />
            <div class="cover-overlay">
              <button
                type="button"
                class="btn-cover-preview"
                data-open-modal
                data-pdf={edicion.archivoPdf}
                data-title={`Edición N.° ${edicion.numero} (${edicion.fecha})`}
                aria-label={`Ver Edición N.° ${edicion.numero} en pantalla completa`}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  <line x1="11" y1="8" x2="11" y2="14"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
                <span>Clic para ver en grande</span>
              </button>
            </div>
          </div>
          <div class="cover-footer-note">
            <span>📄 Formato PDF Original ({edicion.paginas || 14} páginas · {edicion.peso || '3.5 MB'})</span>
          </div>
        </div>

        <!-- Columna Derecha: Información Editorial y Acciones -->
        <div class="featured-info-col">
          <div class="edition-badges">
            <span class="badge badge-burgundy">Edición N.° {edicion.numero}</span>
            <span class="edition-date">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              {edicion.fecha}
            </span>
          </div>

          <h3 class="featured-headline">
            {edicion.titular}
          </h3>

          <p class="featured-description">
            {edicion.bajada}
          </p>

          {edicion.titularesSecundarios && edicion.titularesSecundarios.length > 0 && (
            <div class="inside-news-box">
              <h4 class="inside-news-title">En esta edición semanal:</h4>
              <ul class="inside-news-list">
                {edicion.titularesSecundarios.map((noticia) => (
                  <li>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                    <span>{noticia}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Botones de Acción -->
          <div class="featured-actions">
            <!-- Botón 1: Leer en Visor Web -->
            <button
              type="button"
              id="btn-leer-destacada"
              class="btn btn-primary btn-action-main"
              data-open-modal
              data-pdf={edicion.archivoPdf}
              data-title={`Edición N.° ${edicion.numero} - ${edicion.fecha}`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
              </svg>
              <span>Leer en Pantalla</span>
            </button>

            <!-- Botón 2: Descargar PDF -->
            <a
              href={edicion.archivoPdf}
              download={`Tribuna-Mochica-${edicion.numero}.pdf`}
              class="btn btn-secondary btn-action-download"
              title="Descargar archivo PDF completo"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Descargar PDF</span>
            </a>

            <!-- Botón 3: Compartir Edición -->
            <button
              type="button"
              class="btn btn-outline btn-action-share"
              data-share-btn
              data-share-title={`Tribuna Mochica - Edición N.° ${edicion.numero}`}
              data-share-text={edicion.titular}
              data-share-url={`/edicion/${edicion.id}`}
              title="Compartir enlace de esta edición"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
              <span>Compartir</span>
            </button>
          </div>
        </div>
      </div>
    </article>
  </div>
</section>
