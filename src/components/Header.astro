---
// Header.astro - Cabecera Editorial para Tribuna Mochica (Bordes Redondeados)
---

  <!-- 2. Cabecera Principal / Masthead Editorial -->
  <div class="masthead">
    <div class="container masthead-inner">
      
      <!-- Logo Principal con Bordes Redondeados -->
      <a href="/" class="masthead-brand" title="Tribuna Mochica - Inicio">
        <img 
          src="/logo.png" 
          onerror="this.onerror=null; this.src='/logo.jpg'; this.onerror=() => { this.src='/logo-mochica.svg'; }"
          alt="Logotipo Tribuna Mochica" 
          class="masthead-logo"
          width="80" 
          height="80" 
        />
      </a>

      <!-- Títulos y Créditos Editoriales -->
      <div class="masthead-content">
        <div class="masthead-kicker">
          <span class="kicker-line"></span>
          <span class="kicker-text">PERIÓDICO DIGITAL SEMANAL</span>
          <span class="kicker-line"></span>
        </div>

        <h1 class="masthead-title">
          <a href="/">TRIBUNA MOCHICA</a>
        </h1>

        <p class="masthead-slogan">LA VOZ DEL VALLE LA LECHE</p>

        <div class="masthead-director">
          <span class="director-label">Director:</span>
          <span class="director-name">Juan César Cabrejos Becerra</span>
        </div>
      </div>

    </div>
  </div>

  <!-- Línea Doble Tradicional de Prensa -->
  <div class="container">
    <div class="rule-double"></div>
  </div>

  <!-- 3. Menú de Botones con Redondeo Amplio (Igual a la Portada) -->
  <nav class="nav-buttons-wrap" aria-label="Navegación de secciones">
    <div class="container">
      <div class="nav-grid">
        <a href="#portada" class="nav-btn active">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          <span>Portada</span>
        </a>

        <a href="#ultimas-noticias" class="nav-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path><path d="M6 6h10"></path><path d="M6 10h10"></path><path d="M6 14h6"></path></svg>
          <span>Ediciones pasadas</span>
        </a>

        <a href="#enviar-noticia" class="nav-btn nav-btn-cta">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
          <span>Envíanos tu noticia</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- 4. Hero Banner en Tarjeta Redondeada (Mismo estilo que la Tarjeta de Portada) -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-card">
        <h2 class="hero-heading">Lee nuestro periódico desde cualquier lugar</h2>
        <p class="hero-lead">
          Visualiza en pantalla o descarga gratis los archivos PDF de cada edición semanal de <strong>Tribuna Mochica</strong> desde tu celular o computadora.
        </p>
      </div>
    </div>
  </section>
</header>

<style>
  .site-header {
    background-color: var(--color-bg-page);
    border-bottom: 1px solid var(--color-border);
  }

  /* 1. Top Bar */
  .top-bar {
    background-color: var(--color-dark);
    color: var(--color-dark-text);
    font-size: 0.78rem;
    padding: 0.35rem 0;
  }

  .top-bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
  }

  .top-bar-location {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-gold-light);
    font-weight: 500;
  }

  .top-bar-meta {
    display: none;
    color: #C4BCB3;
  }

  @media (min-width: 640px) {
    .top-bar-meta {
      display: block;
    }
  }

  .top-bar-date {
    color: #E2DBD0;
  }

  /* 2. Masthead */
  .masthead {
    padding: 1.25rem 0 0.85rem 0;
    background-color: var(--color-bg-page);
  }

  .masthead-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .masthead-inner {
      flex-direction: row;
      justify-content: center;
      gap: 1.75rem;
      padding: 1.5rem 0 1rem 0;
    }
  }

  .masthead-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .masthead-logo {
    width: 72px;
    height: 72px;
    object-fit: contain;
    border-radius: var(--radius-md);
  }

  @media (min-width: 768px) {
    .masthead-logo {
      width: 90px;
      height: 90px;
    }
  }

  .masthead-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .masthead-kicker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
  }

  .kicker-line {
    display: inline-block;
    width: 20px;
    height: 1px;
    background-color: var(--color-gold);
    border-radius: 9999px;
  }

  .kicker-text {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--color-gold-dark);
  }

  .masthead-title {
    font-size: clamp(1.9rem, 7vw, 3.1rem);
    letter-spacing: 0.02em;
    line-height: 1.05;
    margin: 0;
  }

  .masthead-title a {
    color: var(--color-burgundy);
    transition: color 0.15s ease;
  }

  .masthead-title a:hover {
    color: var(--color-burgundy-light);
  }

  .masthead-slogan {
    font-family: var(--font-sans);
    font-size: clamp(0.75rem, 2.8vw, 0.95rem);
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--color-ink-black);
    margin-top: 0.3rem;
  }

  .masthead-director {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    background-color: var(--color-bg-subtle);
    padding: 0.25rem 0.9rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .director-label {
    font-weight: 600;
    color: var(--color-burgundy);
  }

  .director-name {
    font-weight: 600;
    color: var(--color-ink-black);
  }

  /* 3. Botones con Redondeo Idéntico al de la Portada */
  .nav-buttons-wrap {
    padding: 0.75rem 0 0.5rem 0;
  }

  .nav-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
    width: 100%;
  }

  .nav-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.7rem 0.6rem;
    font-size: 0.88rem;
    font-weight: 600;
    text-align: center;
    color: var(--color-ink-black);
    background-color: #FFFFFF;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg); /* 24px: Mismo redondeo que la portada */
    text-decoration: none;
    transition: all 0.15s ease;
    box-shadow: var(--shadow-sm);
  }

  .nav-btn:hover {
    background-color: var(--color-burgundy-subtle);
    color: var(--color-burgundy);
    border-color: var(--color-burgundy);
    transform: translateY(-1px);
  }

  .nav-btn.active {
    background-color: var(--color-burgundy);
    color: #FFFFFF;
    border-color: var(--color-burgundy);
  }

  .nav-btn-cta {
    border-color: var(--color-gold);
    color: var(--color-burgundy);
  }

  .nav-btn-cta:hover {
    background-color: var(--color-gold-subtle);
  }

  @media (max-width: 520px) {
    .nav-grid {
      gap: 0.4rem;
    }
    .nav-btn {
      font-size: 0.75rem;
      padding: 0.6rem 0.25rem;
      border-radius: var(--radius-md);
      flex-direction: column;
      gap: 0.2rem;
    }
  }

  /* 4. Tarjeta del Hero Banner con Bordes Curvos */
  .hero-section {
    padding: 1.25rem 0 1.75rem 0;
  }

  .hero-card {
    background-color: var(--color-bg-subtle);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg); /* 24px: Mismo radio curvo de la tarjeta de portada */
    padding: 1.5rem 1.25rem;
    text-align: center;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  @media (min-width: 768px) {
    .hero-card {
      padding: 2rem 2rem;
    }
  }

  .hero-heading {
    font-size: clamp(1.4rem, 4.5vw, 2.1rem);
    color: var(--color-ink-black);
    line-height: 1.2;
    margin-top: 0.1rem;
  }

  .hero-lead {
    font-size: clamp(0.9rem, 2.6vw, 1.05rem);
    color: var(--color-ink-body);
    line-height: 1.55;
    max-width: 680px;
    margin-top: 0.2rem;
  }
</style>
