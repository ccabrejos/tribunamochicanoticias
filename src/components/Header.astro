---
const hoy = new Date().toLocaleDateString('es-PE', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<header class="masthead-header">
  <div class="container">
    <div class="top-bar">
      <span>Moche, La Libertad — Perú</span>
      <span class="date-text">{hoy}</span>
      <span>Edición Digital</span>
    </div>

    <div class="logo-box">
      <a href="/" class="title-link">
        <h1 class="newspaper-name">TRIBUNA MOCHICA</h1>
      </a>
      <p class="tagline">Voz, Memoria y Actualidad de Nuestra Comunidad</p>
    </div>

    <nav class="nav-links">
      <a href="/#noticias">Noticias</a>
      <span class="dot">•</span>
      <a href="/#ediciones">Edición Impresa PDF</a>
      <span class="dot">•</span>
      <a href="/#contacto">Redacción</a>
    </nav>
  </div>
</header>

<style>
  .masthead-header {
    border-bottom: 3px double var(--border-dark);
    padding-top: 0.5rem;
    background-color: var(--bg-paper);
  }

  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid var(--border-rule);
    padding-bottom: 0.35rem;
  }

  .date-text {
    text-transform: capitalize;
  }

  .logo-box {
    text-align: center;
    padding: 1rem 0 0.5rem;
  }

  .newspaper-name {
    font-size: 2.1rem;
    letter-spacing: -0.5px;
    font-weight: 900;
    line-height: 1;
    color: var(--ink-primary);
  }

  .tagline {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--ink-secondary);
    margin-top: 0.35rem;
  }

  .nav-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    border-top: 1px solid var(--border-rule);
    padding: 0.45rem 0;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
  }

  .nav-links a:hover {
    color: var(--color-accent);
  }

  .dot {
    color: var(--border-rule);
  }

  @media (min-width: 768px) {
    .newspaper-name {
      font-size: 3.2rem;
      letter-spacing: 1px;
    }
    .top-bar {
      font-size: 0.8rem;
    }
  }
</style>
