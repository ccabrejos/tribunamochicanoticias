---
// Cabecera Principal / Masthead Editorial
---
<header class="masthead">
  <div class="container masthead-inner">
    <!-- Logo Principal -->
    <a href="/" class="masthead-brand" title="Tribuna Mochica - Inicio">
      <img
        src="/logo.jpg"
        onerror="this.onerror=null; this.src='/logo-mochica.svg';"
        alt="Logotipo Tribuna Mochica"
        class="masthead-logo"
        width="85"
        height="85"
      />
    </a>

    <!-- Títulos y Créditos Editoriales -->
    <div class="masthead-content">
      <div class="masthead-kicker">
        <span class="kicker-line"></span>
        <span class="kicker-text">SEMANARIO DIGITAL SEMANAL</span>
        <span class="kicker-line"></span>
      </div>

      <h1 class="masthead-title">
        <a href="/">TRIBUNA MOCHICA</a>
      </h1>

      <p class="masthead-slogan">LA VOZ DEL VALLE LA LECHE</p>

      <div class="masthead-director">
        <span class="director-label">Director:</span>
        <span class="director-name">Juan César Cabrejos Becerra</span>
      </div>
    </div>
  </div>
</header>

<!-- Línea Doble Tradicional de Prensa -->
<div class="container">
  <div class="rule-double"></div>
</div>
