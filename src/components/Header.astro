---
// Header.astro - Cabecera tradicional y elegante de Tribuna Mochica
---

<header class="site-header">
  <!-- Barra superior con fecha y ubicación -->
  <div class="top-bar">
    <div class="container top-bar-inner">
      <div class="top-bar-location">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span>Lambayeque, Perú · Valle La Leche</span>
      </div>
      <div class="top-bar-tagline">
        <span>Periódico Semanal de Información Regional</span>
      </div>
      <div class="top-bar-date" id="current-date">
        <span>Edición Digital Semanal</span>
      </div>
    </div>
  </div>

  <!-- Cabecera Principal (Masthead estilo periódico de prestigio) -->
  <div class="masthead">
    <div class="container masthead-inner">
      <!-- Logo Isotipo Mochica -->
      <a href="/" class="logo-link" title="Tribuna Mochica - Inicio">
        <img src="/logo-mochica.svg" alt="Logotipo Mochica Tribuna" class="masthead-logo" width="90" height="90" />
      </a>

      <!-- Bloque Central de Títulos -->
      <div class="masthead-titles">
        <div class="masthead-pretitle">
          <span class="gold-line"></span>
          <span class="pretitle-text">HEMEROTECA DIGITAL & PERIÓDICO SEMANAL</span>
          <span class="gold-line"></span>
        </div>

        <h1 class="main-title">
          <a href="/">TRIBUNA MOCHICA</a>
        </h1>

        <p class="masthead-slogan">LA VOZ DEL VALLE LA LECHE</p>

        <div class="masthead-director">
          <span class="director-label">Director:</span>
          <strong class="director-name">Juan César Cabrejos Becerra</strong>
        </div>
      </div>

      <!-- Espacio equilibrado lateral / Emblema secundario -->
      <div class="masthead-side">
        <div class="seal-badge">
          <span class="seal-year">Desde</span>
          <span class="seal-num">Valle La Leche</span>
          <span class="seal-text">Prensa Independiente</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Franja divisoria institucional -->
  <div class="divider-mochica"></div>

  <!-- Barra de Navegación Rápida y Accesible -->
  <nav class="main-nav" aria-label="Navegación principal">
    <div class="container nav-inner">
      <ul class="nav-links">
        <li>
          <a href="#portada" class="nav-link active">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            <span>Portada Actual</span>
          </a>
        </li>
        <li>
          <a href="#ultimas-noticias" class="nav-link">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path><path d="M6 6h10"></path><path d="M6 10h10"></path><path d="M6 14h6"></path></svg>
            <span>Últimas Noticias & Ediciones</span>
          </a>
        </li>
        <li>
          <a href="#enviar-noticia" class="nav-link nav-link-highlight">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
            <span>Envíanos tu Noticia</span>
          </a>
        </li>
      </ul>

      <div class="nav-cta">
        <a href="#portada" class="btn-read-now" onclick="document.querySelector('#btn-leer-destacada')?.click()">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
          <span>Leer Última Edición</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- Banner Hero: "Lee nuestro periódico desde cualquier lugar" -->
  <section class="hero-banner">
    <div class="container hero-inner">
      <div class="hero-badge">
        <span class="badge badge-burgundy">HEMEROTECA ABIERTA</span>
        <span class="hero-edition-tag">Acceso Libre y Gratuito</span>
      </div>
      <h2 class="hero-title">Lee nuestro periódico desde cualquier lugar</h2>
      <p class="hero-subtitle">
        Consulta en pantalla o descarga los archivos PDF de cada edición semanal de <strong>Tribuna Mochica</strong> desde tu celular, tablet o computadora.
      </p>
    </div>
  </section>
</header>

<style>
  .site-header {
    background-color: var(--color-bg-warm);
    border-bottom: 1px solid var(--color-border);
  }

  /* Top Bar */
  .top-bar {
    background-color: var(--color-dark);
    color: #FFFFFF;
    font-size: 0.8rem;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--color-dark-surface);
  }

  .top-bar-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .top-bar-location {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-gold-light);
    font-weight: 500;
  }

  .top-bar-tagline {
    color: var(--color-text-light);
    display: none;
  }

  @media (min-width: 768px) {
    .top-bar-tagline {
      display: block;
    }
  }

  .top-bar-date {
    color: #E2DBD0;
  }

  /* Masthead */
  .masthead {
    padding: 1.75rem 0 1.5rem 0;
    background: linear-gradient(180deg, #FFFFFF 0%, #FAF8F2 100%);
  }

  .masthead-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    text-align: center;
  }

  .logo-link {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .logo-link:hover {
    transform: scale(1.04);
  }

  .masthead-logo {
    width: 85px;
    height: 85px;
  }

  .masthead-titles {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .masthead-pretitle {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .gold-line {
    display: inline-block;
    width: 30px;
    height: 1px;
    background-color: var(--color-gold);
  }

  .pretitle-text {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--color-gold-dark);
  }

  .main-title {
    font-size: 2.3rem;
    letter-spacing: 0.04em;
    margin: 0;
    line-height: 1.1;
  }

  .main-title a {
    color: var(--color-burgundy);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .main-title a:hover {
    color: var(--color-burgundy-light);
  }

  .masthead-slogan {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--color-dark);
    margin-top: 0.35rem;
    text-transform: uppercase;
  }

  .masthead-director {
    margin-top: 0.45rem;
    font-size: 0.88rem;
    color: var(--color-text-body);
    background-color: var(--color-bg-subtle);
    padding: 0.2rem 0.9rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .director-label {
    color: var(--color-burgundy);
    font-weight: 600;
  }

  .director-name {
    color: var(--color-dark);
  }

  .masthead-side {
    display: none;
    flex-shrink: 0;
  }

  .seal-badge {
    border: 2px dashed var(--color-gold);
    background-color: var(--color-gold-subtle);
    padding: 0.6rem 0.9rem;
    border-radius: var(--radius-md);
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .seal-year {
    font-size: 0.68rem;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .seal-num {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-burgundy);
    font-family: var(--font-serif);
  }

  .seal-text {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-gold-dark);
  }

  @media (min-width: 860px) {
    .masthead-side {
      display: block;
    }
    .main-title {
      font-size: 3rem;
    }
    .masthead-logo {
      width: 105px;
      height: 105px;
    }
  }

  /* Main Navigation */
  .main-nav {
    background-color: #FFFFFF;
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 40;
    box-shadow: var(--shadow-sm);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.4rem;
    padding-bottom: 0.4rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    overflow-x: auto;
    padding: 0.25rem 0;
    -webkit-overflow-scrolling: touch;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.85rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-body);
    border-radius: var(--radius-sm);
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .nav-link:hover {
    color: var(--color-burgundy);
    background-color: var(--color-burgundy-subtle);
  }

  .nav-link-highlight {
    color: var(--color-burgundy);
  }

  .btn-read-now {
    display: none;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 1rem;
    font-size: 0.82rem;
    font-weight: 700;
    background-color: var(--color-burgundy);
    color: #FFFFFF;
    border-radius: var(--radius-full);
    transition: all 0.2s ease;
  }

  .btn-read-now:hover {
    background-color: var(--color-burgundy-light);
  }

  @media (min-width: 640px) {
    .btn-read-now {
      display: inline-flex;
    }
  }

  /* Hero Banner */
  .hero-banner {
    padding: 2.25rem 0 2rem 0;
    background: radial-gradient(circle at center, #FFFFFF 0%, #F5F2EB 100%);
    border-bottom: 1px solid var(--color-border);
    text-align: center;
  }

  .hero-inner {
    max-width: 780px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #FFFFFF;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    margin-bottom: 0.85rem;
  }

  .hero-edition-tag {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .hero-title {
    font-size: 1.85rem;
    color: var(--color-text-main);
    margin-bottom: 0.6rem;
    line-height: 1.2;
  }

  .hero-subtitle {
    font-size: 1rem;
    color: var(--color-text-body);
    line-height: 1.55;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 2.35rem;
    }
    .hero-subtitle {
      font-size: 1.1rem;
    }
  }
</style>
