---
interface Props {
  slug: string;
  titulo: string;
  bajada: string;
  autor: string;
  categoria: string;
  fechaFormateada: string;
  imagen: string;
  tiempoLectura: string;
  destacado?: boolean;
}

const { slug, titulo, bajada, autor, categoria, fechaFormateada, imagen, tiempoLectura, destacado = false } = Astro.props;
---

<article class={`newspaper-card news-card ${destacado ? 'is-featured' : ''}`}>
  <a href={`/noticias/${slug}`} class="news-card-image-link" aria-label={`Leer: ${titulo}`}>
    <div class="image-wrapper">
      <img src={imagen} alt={titulo} loading="lazy" width="600" height="340" />
      <span class="badge-category">{categoria}</span>
    </div>
  </a>

  <div class="news-card-content">
    <div class="news-meta">
      <span class="news-date">{fechaFormateada}</span>
      <span class="meta-dot">•</span>
      <span class="news-reading-time">{tiempoLectura}</span>
    </div>

    <h3 class="news-title">
      <a href={`/noticias/${slug}`}>{titulo}</a>
    </h3>

    <p class="news-excerpt">{bajada}</p>

    <div class="news-card-footer">
      <div class="news-author">
        <span class="author-label">Redacción:</span>
        <strong class="author-name">{autor}</strong>
      </div>
      <a href={`/noticias/${slug}`} class="read-more-link">
        Leer noticia
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
    </div>
  </div>
</article>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .news-card-image-link {
    display: block;
    overflow: hidden;
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-papel-oscuro);
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .news-card:hover .image-wrapper img {
    transform: scale(1.04);
  }

  .badge-category {
    position: absolute;
    top: 12px;
    left: 12px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  .news-card-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .news-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-tinta-suave);
    margin-bottom: 0.5rem;
  }

  .meta-dot {
    color: var(--color-ocre);
  }

  .news-title {
    font-size: 1.3rem;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .news-title a {
    color: var(--color-vino);
  }

  .news-title a:hover {
    color: var(--color-vino-oscuro);
    text-decoration: underline;
  }

  .news-excerpt {
    font-size: 0.95rem;
    color: var(--color-tinta-suave);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .news-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-borde);
    font-size: 0.88rem;
  }

  .news-author {
    display: flex;
    flex-direction: column;
  }

  .author-label {
    font-size: 0.75rem;
    color: var(--color-tinta-suave);
    text-transform: uppercase;
  }

  .author-name {
    color: var(--color-tinta);
    font-size: 0.85rem;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 700;
    color: var(--color-vino) !important;
    font-size: 0.9rem;
  }

  .read-more-link:hover {
    color: var(--color-vino-oscuro) !important;
    transform: translateX(2px);
  }

  /* Tarjeta destacada */
  @media (min-width: 860px) {
    .news-card.is-featured {
      grid-column: span 2;
      display: grid;
      grid-template-columns: 1.1fr 1fr;
    }

    .news-card.is-featured .image-wrapper {
      height: 100%;
      aspect-ratio: auto;
    }

    .news-card.is-featured .news-title {
      font-size: 1.65rem;
    }

    .news-card.is-featured .news-card-content {
      padding: 1.75rem;
    }
  }
</style>
