---
// Lector Modal de PDF adaptable: visor embebido en escritorio y apertura nativa fluida en celulares
---
<div
  id="pdf-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-2 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="pdf-modal-title"
>
  <div class="bg-white w-full max-w-5xl h-[92vh] rounded-lg shadow-2xl flex flex-col overflow-hidden border border-line">
    <div class="flex items-center justify-between gap-3 px-4 sm:px-6 py-3.5 border-b border-line bg-white">
      <div class="min-w-0">
        <p class="text-[11px] uppercase tracking-[0.16em] text-burgundy font-semibold">Lectura de edición PDF</p>
        <h3 id="pdf-modal-title" class="font-serif text-base sm:text-lg font-bold text-ink truncate">
          Tribuna Mochica
        </h3>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a
          id="pdf-modal-open"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold border border-line rounded-md text-ink hover:bg-surface transition-colors"
        >
          Abrir aparte ↗
        </a>
        <a
          id="pdf-modal-download"
          href="#"
          download
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-md bg-burgundy text-white hover:bg-burgundy-dark transition-colors"
        >
          Descargar
        </a>
        <button
          id="pdf-modal-close"
          type="button"
          class="w-8 h-8 rounded-md border border-line flex items-center justify-center text-ink hover:bg-surface transition-colors"
          aria-label="Cerrar lector"
        >
          ✕
        </button>
      </div>
    </div>

    <div class="flex-1 bg-surface relative overflow-hidden">
      <iframe
        id="pdf-modal-frame"
        src=""
        title="Visor de periódico PDF"
        class="w-full h-full border-0"
      ></iframe>

      <!-- Respaldo limpio para celulares si el navegador bloquea la pestaña automática -->
      <div
        id="pdf-mobile-fallback"
        class="hidden absolute inset-0 bg-surface flex-col items-center justify-center p-6 text-center"
      >
        <div class="max-w-sm bg-white border border-line rounded-xl p-6 shadow-sm">
          <p class="text-xs uppercase tracking-[0.16em] text-burgundy font-bold mb-2">
            Lectura en celular
          </p>
          <h4 id="pdf-mobile-title" class="font-serif text-xl font-black text-ink mb-2">
            Edición PDF lista
          </h4>
          <p class="text-sm text-muted mb-6">
            Para leer todas las páginas con zoom cómodo en tu teléfono, ábrela en pantalla completa o descárgala.
          </p>
          <div class="flex flex-col gap-3">
            <a
              id="pdf-mobile-open"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3 px-4 rounded-lg bg-burgundy text-white text-sm font-bold hover:bg-burgundy-dark transition-colors"
            >
              Abrir PDF en pantalla completa ↗
            </a>
            <a
              id="pdf-mobile-download"
              href="#"
              download
              class="w-full py-3 px-4 rounded-lg border border-ink text-ink text-sm font-bold hover:bg-ink hover:text-white transition-colors"
            >
              Descargar PDF
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('pdf-modal');
  const frame = document.getElementById('pdf-modal-frame') as HTMLIFrameElement | null;
  const mobileFallback = document.getElementById('pdf-mobile-fallback');
  const mobileTitle = document.getElementById('pdf-mobile-title');
  const mobileOpen = document.getElementById('pdf-mobile-open') as HTMLAnchorElement | null;
  const mobileDownload = document.getElementById('pdf-mobile-download') as HTMLAnchorElement | null;
  const titleEl = document.getElementById('pdf-modal-title');
  const downloadEl = document.getElementById('pdf-modal-download') as HTMLAnchorElement | null;
  const openEl = document.getElementById('pdf-modal-open') as HTMLAnchorElement | null;
  const closeBtn = document.getElementById('pdf-modal-close');

  function isMobileDevice() {
    return (
      window.matchMedia('(max-width: 768px)').matches ||
      /Android|iPhone|iPad|iPod/i.test(navigator.userAgent)
    );
  }

  function openPdfModal(pdfUrl: string, title: string) {
    if (!modal || !frame) return;

    // En celulares, los iframes de PDF suelen fallar o mostrar solo 1 página: abrir directo en visor nativo
    if (isMobileDevice()) {
      const opened = window.open(pdfUrl, '_blank', 'noopener,noreferrer');
      if (opened) return;

      // Si el navegador bloqueó la ventana emergente, mostrar tarjeta clara dentro del modal
      frame.src = '';
      frame.classList.add('hidden');
      if (mobileFallback) {
        mobileFallback.classList.remove('hidden');
        mobileFallback.classList.add('flex');
      }
      if (mobileTitle) mobileTitle.textContent = title || 'Edición PDF';
      if (mobileOpen) mobileOpen.href = pdfUrl;
      if (mobileDownload) mobileDownload.href = pdfUrl;
    } else {
      frame.classList.remove('hidden');
      if (mobileFallback) {
        mobileFallback.classList.add('hidden');
        mobileFallback.classList.remove('flex');
      }
      frame.src = pdfUrl;
    }

    if (titleEl) titleEl.textContent = title || 'Edición PDF';
    if (downloadEl) downloadEl.href = pdfUrl;
    if (openEl) openEl.href = pdfUrl;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closePdfModal() {
    if (!modal || !frame) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    frame.src = '';
    document.body.style.overflow = '';
  }

  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement)?.closest('[data-open-pdf]') as HTMLElement | null;
    if (target) {
      e.preventDefault();
      const pdfUrl = target.getAttribute('data-pdf') || '';
      const title = target.getAttribute('data-title') || 'Edición PDF';
      if (pdfUrl) openPdfModal(pdfUrl, title);
    }
  });

  closeBtn?.addEventListener('click', closePdfModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closePdfModal();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePdfModal();
  });
</script>
